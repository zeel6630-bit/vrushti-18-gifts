<script>

/* =========================================================
   THE ZEEL ARCHIVE
========================================================= */

const pages =
  Array.from(
    document.querySelectorAll(".page")
  );

const previous =
  document.getElementById("previous");

const next =
  document.getElementById("next");

const pageCounter =
  document.getElementById("pageCounter");

const pageTurn =
  document.getElementById("pageTurn");

let currentPage=0;


/* =========================================================
   SHOW PAGE
========================================================= */

function showPage(index){

  if(index<0){
    index=0;
  }

  if(index>=pages.length){
    index=pages.length-1;
  }

  currentPage=index;


  pageTurn.classList.add("active");


  setTimeout(()=>{

    pages.forEach(
      page=>{
        page.classList.remove("active");
      }
    );

    pages[currentPage].classList.add(
      "active"
    );


    pageCounter.textContent=
      `${String(currentPage+1).padStart(2,"0")} / 18`;


    previous.disabled=
      currentPage===0;

    next.disabled=
      currentPage===pages.length-1;


    window.scrollTo({
      top:0,
      behavior:"smooth"
    });


    setTimeout(()=>{
      pageTurn.classList.remove(
        "active"
      );
    },120);

  },120);

}


/* =========================================================
   BUTTONS
========================================================= */

previous.addEventListener(
  "click",
  ()=>{
    showPage(
      currentPage-1
    );
  }
);

next.addEventListener(
  "click",
  ()=>{
    showPage(
      currentPage+1
    );
  }
);


/* =========================================================
   KEYBOARD
========================================================= */

document.addEventListener(
  "keydown",
  event=>{

    if(
      event.key==="ArrowRight"
    ){

      if(
        currentPage<
        pages.length-1
      ){

        showPage(
          currentPage+1
        );

      }

    }


    if(
      event.key==="ArrowLeft"
    ){

      if(
        currentPage>0
      ){

        showPage(
          currentPage-1
        );

      }

    }

  }
);


/* =========================================================
   AMBIENT DUST
========================================================= */

const background =
  document.querySelector(
    ".background"
  );


for(
  let i=0;
  i<35;
  i++
){

  const dust =
    document.createElement(
      "div"
    );

  dust.className="dust";

  dust.style.left =
    Math.random()*100+"%";

  dust.style.animationDuration =
    (10+Math.random()*15)+"s";

  dust.style.animationDelay =
    (-Math.random()*20)+"s";

  dust.style.width =
  dust.style.height =
    (2+Math.random()*3)+"px";

  background.appendChild(
    dust
  );

}


/* =========================================================
   INITIAL STATE
========================================================= */

showPage(0);

</script>

