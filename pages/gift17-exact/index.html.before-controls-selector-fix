<script>
(function () {

    "use strict";

    /*
     * ========================================================
     * GIFT 17 — REAL PICTURE SWITCHER
     * ========================================================
     *
     * This talks to the ORIGINAL Jigsaw engine.
     *
     * We do NOT create another puzzle.
     * We do NOT create another image preview.
     *
     * The original engine's:
     *
     *     puzzle.srcImage
     *
     * is the single source of truth.
     * ========================================================
     */

    const imageCandidates = function (number) {

        const n =
            String(number).padStart(2, "0");

        return [
            "./images/" + n + ".jpg",
            "./images/" + n + ".jpeg",
            "./images/" + n + ".png",
            "./images/" + n + ".webp"
        ];

    };


    /*
     * Find the picture dropdown that already exists.
     */
    function findPictureSelect() {

        const selects =
            Array.from(
                document.querySelectorAll("select")
            );

        return selects.find(function (select) {

            return Array.from(
                select.options || []
            ).some(function (option) {

                return /^Picture\s+\d+$/i.test(
                    option.textContent.trim()
                );

            });

        }) || null;

    }


    /*
     * Make the dropdown contain ONLY:
     *
     * Picture 01
     * Picture 02
     * ...
     * Picture 18
     */
    function normalizePictureSelect(select) {

        if (!select) {
            return;
        }

        const oldValue =
            Number(select.value) || 1;

        select.innerHTML = "";

        for (let i = 1; i <= 18; i++) {

            const option =
                document.createElement("option");

            option.value =
                String(i);

            option.textContent =
                "Picture " +
                String(i).padStart(2, "0");

            select.appendChild(option);

        }

        select.value =
            String(
                Math.max(
                    1,
                    Math.min(18, oldValue)
                )
            );

    }


    /*
     * Remove the garbage text rows from the old
     * Picture Library implementation.
     *
     * IMPORTANT:
     * We NEVER touch <option> elements.
     */
    function removeOldPictureRows() {

        const elements =
            Array.from(
                document.querySelectorAll("body *")
            );

        elements.forEach(function (element) {

            if (
                element.tagName === "OPTION" ||
                element.tagName === "SELECT"
            ) {
                return;
            }

            /*
             * Don't remove buttons that belong to
             * the original Jigsaw controls.
             */
            if (
                element.tagName === "BUTTON"
            ) {
                const text =
                    element.textContent
                        .replace(/\s+/g, " ")
                        .trim()
                        .toLowerCase();

                if (
                    text === "show image" ||
                    text === "start game" ||
                    text === "stop game" ||
                    text === "instructions" ||
                    text === "default image" ||
                    text === "load image"
                ) {
                    return;
                }
            }

            /*
             * Only target elements whose entire visible
             * text is exactly "Picture XX".
             */
            const text =
                element.textContent
                    .replace(/\s+/g, " ")
                    .trim();

            if (
                /^Picture\s+(0?[1-9]|1[0-8])$/i.test(text)
            ) {

                /*
                 * Never remove our actual selector.
                 */
                if (
                    element.contains &&
                    element.contains(
                        document.getElementById(
                            "gift17-picture-select"
                        )
                    )
                ) {
                    return;
                }

                /*
                 * Don't remove the SELECT itself.
                 */
                if (
                    element.tagName !== "SELECT"
                ) {
                    element.classList.add(
                        "gift17-remove-picture-row"
                    );
                }

            }

        });


        /*
         * Remove the previous custom
         * "SHOW SELECTED IMAGE" button.
         */
        Array.from(
            document.querySelectorAll("button")
        ).forEach(function (button) {

            const text =
                button.textContent
                    .replace(/\s+/g, " ")
                    .trim()
                    .toLowerCase();

            if (
                text === "show selected image" ||
                text === "show selected picture"
            ) {

                button.classList.add(
                    "gift17-remove-selected-button"
                );

                button.remove();

            }

        });

    }


    /*
     * Load the actual selected file.
     */
    function loadSelectedPicture(number) {

        if (
            !window.puzzle &&
            typeof puzzle === "undefined"
        ) {

            console.error(
                "[Gift17] Original puzzle object is not ready."
            );

            return;

        }


        /*
         * The original source uses the global puzzle
         * object. Prefer window.puzzle when available.
         */
        const p =
            window.puzzle ||
            (
                typeof puzzle !== "undefined"
                    ? puzzle
                    : null
            );


        if (!p || !p.srcImage) {

            console.error(
                "[Gift17] puzzle.srcImage is unavailable."
            );

            return;

        }


        const candidates =
            imageCandidates(number);

        let index = 0;


        /*
         * Find which actual file exists.
         */
        function tryNext() {

            if (
                index >= candidates.length
            ) {

                console.error(
                    "[Gift17] Picture " +
                    number +
                    " was not found."
                );

                return;

            }


            const url =
                candidates[index++];

            const probe =
                new Image();


            probe.onload = function () {

                /*
                 * If a puzzle is currently running,
                 * stop it first.
                 */
                const stop =
                    document.getElementById("stop");

                if (
                    stop &&
                    !stop.disabled
                ) {

                    stop.click();

                }


                /*
                 * Give the ORIGINAL puzzle image
                 * the selected file.
                 */
                p.imageLoaded = false;

                p.srcImage.removeAttribute(
                    "src"
                );

                /*
                 * Use the original engine's loader
                 * when it exists.
                 */
                if (
                    typeof loadRemoteFile ===
                    "function"
                ) {

                    loadRemoteFile(url);

                } else {

                    p.srcImage.src = url;

                }


                p.srcImage.dataset.origin =
                    "gift17-picture-" +
                    String(number).padStart(2, "0");


                console.log(
                    "[Gift17] Selected Picture " +
                    String(number).padStart(2, "0") +
                    " → " +
                    url
                );

            };


            probe.onerror = function () {

                tryNext();

            };


            probe.src =
                url +
                (
                    url.includes("?")
                        ? "&"
                        : "?"
                ) +
                "gift17=" +
                Date.now();

        }


        tryNext();

    }


    /*
     * Install everything ONCE.
     */
    function install() {

        const select =
            findPictureSelect();

        if (!select) {

            console.warn(
                "[Gift17] Picture dropdown not found."
            );

            return;

        }


        /*
         * Normalize it.
         */
        normalizePictureSelect(select);


        /*
         * Give it our permanent ID.
         */
        select.id =
            "gift17-picture-select";


        /*
         * Put it inside a single clean wrapper
         * if it isn't already there.
         */
        if (
            !document.getElementById(
                "gift17-picture-control"
            )
        ) {

            const label =
                document.createElement("label");

            label.textContent =
                "PICTURE";

            label.htmlFor =
                "gift17-picture-select";


            const wrapper =
                document.createElement("div");

            wrapper.id =
                "gift17-picture-control";


            select.parentNode.insertBefore(
                wrapper,
                select
            );

            wrapper.appendChild(label);
            wrapper.appendChild(select);

        }


        /*
         * Install ONE change listener.
         */
        if (
            select.dataset.gift17Bound !== "1"
        ) {

            select.dataset.gift17Bound =
                "1";


            select.addEventListener(
                "change",
                function () {

                    const number =
                        Number(select.value);

                    console.log(
                        "[Gift17] Picture changed to:",
                        number
                    );

                    loadSelectedPicture(
                        number
                    );

                }
            );

        }


        /*
         * Delete the old 18-line garbage.
         */
        removeOldPictureRows();


        /*
         * Load the currently selected picture.
         */
        if (
            select.dataset.gift17InitialLoad !== "1"
        ) {

            select.dataset.gift17InitialLoad =
                "1";

            setTimeout(
                function () {

                    loadSelectedPicture(
                        Number(select.value) || 1
                    );

                },
                150
            );

        }

    }


    /*
     * The original scripts are already loaded because
     * this code is appended after them.
     */
    setTimeout(
        install,
        250
    );

})();
</script>

