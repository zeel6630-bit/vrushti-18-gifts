<style>
/* ============================================================
   GIFT 17 — FINAL PICTURE LIBRARY MODAL BEHAVIOUR
   ============================================================ */

.gift17-library-hidden {
    display: none !important;
}
</style>

<script>
(function () {

    function findLibraryPanels() {

        const elements = Array.from(
            document.querySelectorAll("body *")
        );

        const panels = [];

        for (const el of elements) {

            /*
             * Find the actual heading element whose text is
             * exactly "PICTURE LIBRARY".
             */
            const text = (el.textContent || "")
                .replace(/\s+/g, " ")
                .trim()
                .toUpperCase();

            if (text !== "PICTURE LIBRARY") {
                continue;
            }

            /*
             * Walk upward until we reach the visual card that
             * contains the selector/button.
             */
            let panel = el;

            for (let i = 0; i < 8 && panel; i++) {

                if (
                    panel.querySelector &&
                    (
                        panel.querySelector("select") ||
                        Array.from(panel.querySelectorAll("button"))
                            .some(b =>
                                (b.textContent || "")
                                .toUpperCase()
                                .includes("SHOW SELECTED IMAGE")
                            )
                    )
                ) {
                    break;
                }

                panel = panel.parentElement;
            }

            if (
                panel &&
                panel !== document.body &&
                !panels.includes(panel)
            ) {
                panels.push(panel);
            }
        }

        return panels;
    }


    function closeAllPictureLibraries() {

        const panels = findLibraryPanels();

        console.log(
            "[Gift17] Closing Picture Library panels:",
            panels.length
        );

        panels.forEach(panel => {

            panel.classList.add(
                "gift17-library-hidden"
            );

            /*
             * Also hide any old modal-style wrapper around it.
             */
            let parent = panel.parentElement;

            for (let i = 0; i < 3 && parent; i++) {

                const parentText =
                    (parent.textContent || "")
                    .replace(/\s+/g, " ")
                    .trim()
                    .toUpperCase();

                if (
                    parentText.includes("PICTURE LIBRARY") &&
                    parent !== document.body
                ) {
                    parent.classList.add(
                        "gift17-library-hidden"
                    );
                }

                parent = parent.parentElement;
            }
        });

        /*
         * Hide our previous reopen button if it exists.
         * We don't want it appearing immediately after selection.
         */
        document
            .querySelectorAll(".gift17-library-reopen")
            .forEach(btn => {
                btn.style.display = "none";
            });
    }


    function installShowButtons() {

        const buttons = Array.from(
            document.querySelectorAll("button")
        ).filter(button =>
            (button.textContent || "")
                .replace(/\s+/g, " ")
                .trim()
                .toUpperCase()
                .includes("SHOW SELECTED IMAGE")
        );

        buttons.forEach(button => {

            if (
                button.dataset.gift17CloseInstalled === "1"
            ) {
                return;
            }

            button.dataset.gift17CloseInstalled = "1";

            button.addEventListener(
                "click",
                function () {

                    /*
                     * Allow the original image-selection
                     * handler to run first.
                     */
                    setTimeout(
                        closeAllPictureLibraries,
                        80
                    );

                },
                true
            );
        });
    }


    /*
     * Install now.
     */
    installShowButtons();


    /*
     * The original page can create UI dynamically,
     * so keep watching for the buttons.
     */
    const observer = new MutationObserver(
        function () {
            installShowButtons();
        }
    );

    observer.observe(
        document.body,
        {
            childList: true,
            subtree: true
        }
    );


    /*
     * Also expose it for debugging if needed.
     */
    window.gift17ClosePictureLibrary =
        closeAllPictureLibraries;

})();
</script>


<style>
/* ============================================================
   GIFT 17 — SINGLE PICTURE SELECTOR
   No separate Picture Library cards / overlays
   ============================================================ */

#gift17-inline-picture-selector {
    margin: 10px 0 12px;
    padding: 9px 10px;
    border: 1px solid rgba(90,210,255,.25);
    border-radius: 10px;
    background: rgba(8,15,28,.72);
}

#gift17-inline-picture-selector label {
    display: block;
    margin-bottom: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .8px;
    color: rgba(220,245,255,.78);
}

#gift17-inline-picture-selector select {
    width: 100%;
    box-sizing: border-box;
}

.gift17-library-old {
    display: none !important;
}

.gift17-library-old * {
    display: none !important;
}
</style>

<script>
/* ============================================================
   GIFT 17 — FINAL SINGLE PICTURE SELECTOR
   ============================================================ */

(function () {

    "use strict";

    let installed = false;

    function cleanText(value) {
        return (value || "")
            .replace(/\s+/g, " ")
            .trim()
            .toUpperCase();
    }

    function isPictureSelector(select) {

        if (!select) return false;

        const options = Array.from(select.options || []);

        if (!options.length) return false;

        return options.some(option =>
            /^PICTURE\s*\d+/i.test(
                (option.textContent || "").trim()
            )
        );
    }

    function isShowSelectedButton(button) {

        return cleanText(button.textContent)
            .includes("SHOW SELECTED IMAGE");
    }

    function findLibraryCards() {

        const result = new Set();

        const showButtons = Array.from(
            document.querySelectorAll("button")
        ).filter(isShowSelectedButton);

        for (const button of showButtons) {

            let node = button;

            /*
             * Walk upward until we find the small visual
             * Picture Library card.
             */
            for (let i = 0; i < 8 && node; i++) {

                const text = cleanText(node.textContent);

                const hasLibraryTitle =
                    text.includes("PICTURE LIBRARY");

                const hasPictureSelector =
                    !!node.querySelector &&
                    Array.from(
                        node.querySelectorAll("select")
                    ).some(isPictureSelector);

                const hasShowButton =
                    !!node.querySelector &&
                    Array.from(
                        node.querySelectorAll("button")
                    ).some(isShowSelectedButton);

                /*
                 * A library card normally contains the title
                 * plus either selector/show button or image.
                 */
                if (
                    hasLibraryTitle &&
                    hasShowButton &&
                    (
                        hasPictureSelector ||
                        text.includes("SHOWING PICTURE") ||
                        text.includes("READY")
                    )
                ) {
                    result.add(node);
                    break;
                }

                node = node.parentElement;
            }
        }

        return Array.from(result);
    }

    function findPictureSelector() {

        return Array.from(
            document.querySelectorAll("select")
        ).find(isPictureSelector) || null;
    }

    function findControlsContent() {

        /*
         * Original game uses #showhide for its actual controls.
         */
        const original =
            document.getElementById("showhide");

        if (original) {
            return original;
        }

        /*
         * Fallback for the modified UI.
         */
        const controls =
            document.getElementById("controls");

        if (controls) {
            return controls.parentElement || controls;
        }

        return null;
    }

    function moveSelectorIntoControls(selector) {

        const controls = findControlsContent();

        if (!controls || !selector) {
            return false;
        }

        /*
         * If already installed, don't duplicate it.
         */
        const existing =
            document.getElementById(
                "gift17-inline-picture-selector"
            );

        if (existing) {
            return true;
        }

        const wrapper =
            document.createElement("div");

        wrapper.id =
            "gift17-inline-picture-selector";

        const label =
            document.createElement("label");

        label.textContent =
            "PICTURE";

        label.htmlFor =
            "gift17-inline-picture-select";

        /*
         * Keep the REAL select element.
         *
         * This is important because any existing JavaScript
         * event listeners attached to it remain attached.
         */
        selector.id =
            "gift17-inline-picture-select";

        selector.removeAttribute("style");

        wrapper.appendChild(label);
        wrapper.appendChild(selector);

        /*
         * Put it at the top of the original Controls content.
         */
        controls.insertBefore(
            wrapper,
            controls.firstChild
        );

        return true;
    }

    function removeOldLibraryCards() {

        const cards = findLibraryCards();

        cards.forEach(card => {

            /*
             * Do NOT remove the selector if somehow it is still
             * inside this card. It has already been moved before
             * this function is called.
             */
            if (
                card.querySelector &&
                card.querySelector(
                    "#gift17-inline-picture-select"
                )
            ) {
                return;
            }

            card.classList.add(
                "gift17-library-old"
            );

            /*
             * Completely remove it after hiding it.
             */
            setTimeout(() => {
                if (card.isConnected) {
                    card.remove();
                }
            }, 0);
        });

        /*
         * Remove any remaining "Show Selected Image"
         * buttons that aren't part of the original game.
         */
        document
            .querySelectorAll("button")
            .forEach(button => {

                if (!isShowSelectedButton(button)) {
                    return;
                }

                /*
                 * This is our custom button.
                 */
                button.remove();
            });

        /*
         * Remove stale text labels generated by our previous
         * Picture Library implementation.
         */
        document
            .querySelectorAll("*")
            .forEach(element => {

                if (
                    element.children.length !== 0
                ) {
                    return;
                }

                const text =
                    cleanText(element.textContent);

                if (
                    text === "SHOWING PICTURE 01" ||
                    text === "SHOWING PICTURE 02" ||
                    text === "SHOWING PICTURE 03" ||
                    text === "SHOWING PICTURE 04" ||
                    text === "SHOWING PICTURE 05" ||
                    text === "SHOWING PICTURE 06" ||
                    text === "SHOWING PICTURE 07" ||
                    text === "SHOWING PICTURE 08" ||
                    text === "SHOWING PICTURE 09" ||
                    text === "SHOWING PICTURE 10" ||
                    text === "SHOWING PICTURE 11" ||
                    text === "SHOWING PICTURE 12" ||
                    text === "SHOWING PICTURE 13" ||
                    text === "SHOWING PICTURE 14" ||
                    text === "SHOWING PICTURE 15" ||
                    text === "SHOWING PICTURE 16" ||
                    text === "SHOWING PICTURE 17" ||
                    text === "SHOWING PICTURE 18" ||
                    /^PICTURE\s+\d+\s+READY$/i.test(
                        text
                    )
                ) {
                    element.remove();
                }
            });
    }

    function closeControlsAfterStart() {

        const start =
            document.getElementById("start");

        if (!start) {
            return;
        }

        if (
            start.dataset.gift17StartHook === "1"
        ) {
            return;
        }

        start.dataset.gift17StartHook = "1";

        start.addEventListener(
            "click",
            function () {

                /*
                 * Let the ORIGINAL startGame() handler
                 * execute first.
                 *
                 * Then close the Controls panel.
                 */
                setTimeout(() => {

                    const menu =
                        document.getElementById("menu");

                    if (menu) {
                        menu.classList.add("hidden");
                    }

                    const controls =
                        document.getElementById("controls");

                    if (controls) {
                        controls.textContent =
                            "open controls";
                    }

                }, 80);

            },
            false
        );
    }

    function install() {

        if (!document.body) {
            return false;
        }

        const selector =
            findPictureSelector();

        if (!selector) {
            return false;
        }

        const moved =
            moveSelectorIntoControls(selector);

        if (!moved) {
            return false;
        }

        removeOldLibraryCards();

        closeControlsAfterStart();

        installed = true;

        console.log(
            "[Gift17] Single Picture selector installed."
        );

        return true;
    }

    /*
     * Try immediately.
     */
    install();

    /*
     * The previous implementation creates some of its
     * elements dynamically, so watch the DOM while the page
     * initializes.
     */
    const observer =
        new MutationObserver(() => {

            install();

            /*
             * Once the selector is inside the original controls,
             * keep observing because the old cards can be
             * regenerated by previous code.
             */
        });

    observer.observe(
        document.body,
        {
            childList: true,
            subtree: true
        }
    );

    /*
     * Additional initialization attempts.
     */
    setTimeout(install, 100);
    setTimeout(install, 500);
    setTimeout(install, 1000);
    setTimeout(install, 2000);

})();
</script>


<style>
/* ============================================================
   GIFT 17 — CLEAN PICTURE CONTROL
   ============================================================ */

/* Hide the old custom picture-list rows */
.gift17-remove-picture-row {
    display: none !important;
