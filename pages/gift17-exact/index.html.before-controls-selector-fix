<script>
(function () {
  function removeFloatingPictureLibrary() {
    document.querySelectorAll("body *").forEach(function (el) {
      if (el.closest("#menu")) return;

      const text = (el.textContent || "").trim();
      if (!text) return;

      if (/^PICTURE\s+LIBRARY\b/i.test(text)) {
        el.remove();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", function () {
      setTimeout(removeFloatingPictureLibrary, 100);
      setTimeout(removeFloatingPictureLibrary, 500);
    });
  } else {
    setTimeout(removeFloatingPictureLibrary, 100);
    setTimeout(removeFloatingPictureLibrary, 500);
  }
})();
</script>

