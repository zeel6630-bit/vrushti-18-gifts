  "Smile impact classified as HIGH...",
  "Searching known system bugs...",
  "BUG-001 detected...",
  "BUG-002 detected...",
  "BUG-003 detected...",
  "No immediate repair required...",
  "Checking compatibility modules...",
  "Connection integrity stable...",
  "Running deep personality cross-analysis...",
  "Comparing behavioural patterns...",
  "Generating personality fingerprint...",
  "Building diagnostic report...",
  "Encrypting report sections...",
  "Decrypting final results...",
  "Performing final integrity check...",
  "No replacement unit found...",
  "No duplicate system found...",
  "Finalizing VRUSHTI_OS report..."
];

const logTemplates = [
  "kernel: personality-core loaded successfully",
  "scan: behavioural memory region accessible",
  "scan: emotional processor responding",
  "module: cuteness.dll loaded",
  "module: drama.engine loaded",
  "module: foodie.core loaded",
  "module: sleepy.mode loaded",
  "module: chatter.service loaded",
  "module: chocolate.protocol loaded",
  "module: chai.protocol loaded",
  "warning: randomness level unusually high",
  "warning: cuteness threshold exceeded",
  "notice: baby-mode subsystem detected",
  "analysis: connected emotional system stable",
  "analysis: no malicious behaviour detected",
  "analysis: subject appears intentionally adorable",
  "diagnostic: personality signature generated"
];

/*
  155 seconds = 2 minutes 35 seconds.
  Progress updates smoothly while messages change.
*/
const TOTAL_MS = 155000;
const START = performance.now();

let lastLog = -1;
let lastMessage = -1;

function addLog(text, type=""){
  const line = document.createElement("div");
  line.className = "log-line";

  const prompt = document.createElement("span");
  prompt.className = "prompt";
  prompt.textContent = "vruOS@diagnostic:~$ ";

  const content = document.createElement("span");
  content.className = type;
  content.textContent = text;

  line.appendChild(prompt);
  line.appendChild(content);

  log.appendChild(line);

  while(log.children.length > 13){
    log.removeChild(log.firstChild);
  }
}

function updateScan(now){

  const elapsed = now - START;
  const ratio = Math.min(elapsed / TOTAL_MS, 1);

  /*
    Slightly non-linear progress:
    starts naturally, slows during deep analysis,
    then accelerates toward finalization.
  */
  let progress;

  if(ratio < .12){
    progress = ratio / .12 * 8;
  }else if(ratio < .82){
    progress = 8 + ((ratio - .12) / .70) * 72;
  }else if(ratio < .96){
    progress = 80 + ((ratio - .82) / .14) * 16;
  }else{
    progress = 96 + ((ratio - .96) / .04) * 4;
  }

  progress = Math.min(100, progress);

  progressBar.style.width = progress.toFixed(2) + "%";
  progressPercent.textContent = Math.floor(progress) + "%";

  const byteValue = (progress * 0.047).toFixed(2);
  scanBytes.textContent = byteValue + " GB analyzed";

  const messageIndex = Math.min(
    messages.length - 1,
    Math.floor(ratio * messages.length)
  );

  if(messageIndex !== lastMessage){
    lastMessage = messageIndex;
    scanMessage.textContent = messages[messageIndex];
  }

  const logIndex = Math.floor(elapsed / 3500);

  if(logIndex !== lastLog){
    lastLog = logIndex;

    const source = logTemplates[
      logIndex % logTemplates.length
    ];

    let type = "";

    if(source.includes("warning")){
      type = "warn";
    }

    if(source.includes("cuteness") ||
       source.includes("loaded") ||
       source.includes("stable") ||
       source.includes("generated")){
      type = "good";
    }

    addLog(source, type);
  }

  if(progress < 18){
    progressLabel.textContent = "Booting diagnostic environment...";
    terminalStatus.textContent = "BOOTING";
  }else if(progress < 35){
    progressLabel.textContent = "Scanning personality modules...";
    terminalStatus.textContent = "SCANNING";
  }else if(progress < 55){
    progressLabel.textContent = "Analyzing behavioural patterns...";
    terminalStatus.textContent = "ANALYZING";
  }else if(progress < 72){
    progressLabel.textContent = "Cross-referencing system behaviour...";
    terminalStatus.textContent = "PROCESSING";
  }else if(progress < 88){
    progressLabel.textContent = "Running deep personality analysis...";
    terminalStatus.textContent = "DEEP SCAN";
  }else if(progress < 97){
    progressLabel.textContent = "Generating diagnostic report...";
    terminalStatus.textContent = "GENERATING";
  }else{
    progressLabel.textContent = "Finalizing diagnostic...";
    terminalStatus.textContent = "FINALIZING";
  }

  if(ratio < 1){
    requestAnimationFrame(updateScan);
  }else{
    finishScan();
  }
}

function finishScan(){

  progressBar.style.width = "100%";
  progressPercent.textContent = "100%";
  progressLabel.textContent = "Diagnostic complete.";
  scanMessage.textContent =
    "VRUSHTI_OS successfully analyzed. Report ready.";
  scanStatus.textContent = "COMPLETE";
  terminalStatus.textContent = "COMPLETE";

  addLog("diagnostic: scan completed successfully", "good");
  addLog("diagnostic: personality fingerprint finalized", "good");
  addLog("report: encrypted report decrypted", "good");
  addLog("system: no replacement unit available", "good");

  scanComplete.style.display = "block";

  setTimeout(() => {

    scanner.style.transition =
      "opacity 1.4s ease, transform 1.4s ease";

    scanner.style.opacity = "0";
    scanner.style.transform = "scale(.985)";

    setTimeout(() => {

      scanner.style.display = "none";
      report.style.display = "block";

      window.scrollTo({
        top:0,
        behavior:"instant"
      });

      document.body.style.overflowX = "hidden";

      requestAnimationFrame(() => {
        report.style.opacity = "0";
        report.style.transform = "translateY(20px)";
        report.style.transition =
          "opacity 1.2s ease, transform 1.2s ease";

        requestAnimationFrame(() => {
          report.style.opacity = "1";
          report.style.transform = "translateY(0)";
        });
      });

    },1400);

  },2200);
}


/* Initial terminal boot */

const bootLines = [
  ["BIOS: VRUSHTI Diagnostic Environment v18.10", "good"],
  ["kernel: initializing personality-analysis engine", ""],
  ["memory: allocating secure scan buffer", ""],
  ["network: localhost diagnostic tunnel established", "good"],
  ["target: VRUSHTI_OS", "good"],
  ["mode: EXTREME DEEP SCAN", "warn"],
  ["security: private diagnostic session", ""],
  ["engine: waiting for scan sequence", ""]
];

bootLines.forEach((item,index)=>{
  setTimeout(()=>{
    addLog(item[0],item[1]);
  },index*260);
});

setTimeout(()=>{
  requestAnimationFrame(updateScan);
},2600);
</script>

