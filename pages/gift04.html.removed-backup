<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VRUSHTI_OS // Personality Diagnostic</title>

<style>
:root{
  --bg:#05080a;
  --panel:#091014;
  --panel2:#0d151a;
  --line:rgba(115,255,199,.16);
  --line2:rgba(115,255,199,.28);
  --green:#73ffc7;
  --green2:#42e8aa;
  --soft:#b9ffe5;
  --dim:#6f9287;
  --red:#ff718c;
  --yellow:#ffd86b;
  --blue:#78bfff;
  --white:#eafff7;
  --shadow:0 0 40px rgba(66,232,170,.08);
}

*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  min-height:100vh;
  background:
    radial-gradient(circle at 50% 0%,rgba(49,255,183,.08),transparent 32%),
    radial-gradient(circle at 100% 100%,rgba(67,147,255,.05),transparent 30%),
    #05080a;
  color:var(--white);
  font-family:
    "SFMono-Regular",
    "Cascadia Code",
    "JetBrains Mono",
    "Fira Code",
    Consolas,
    monospace;
  overflow-x:hidden;
}

body::before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  background:
    repeating-linear-gradient(
      to bottom,
      rgba(255,255,255,.012) 0px,
      rgba(255,255,255,.012) 1px,
      transparent 1px,
      transparent 4px
    );
  opacity:.45;
  z-index:100;
}

body::after{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  background:radial-gradient(
    ellipse at center,
    transparent 45%,
    rgba(0,0,0,.45) 100%
  );
  z-index:101;
}

button{
  font:inherit;
}

a{
  color:inherit;
  text-decoration:none;
}

/* =========================================================
   BOOT / SCAN SCREEN
   ========================================================= */

#scanner{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:30px 16px;
  position:relative;
}

.scan-shell{
  width:min(1120px,100%);
  border:1px solid var(--line2);
  background:
    linear-gradient(
      180deg,
      rgba(15,29,32,.96),
      rgba(4,10,13,.98)
    );
  box-shadow:
    0 0 0 1px rgba(115,255,199,.03),
    0 30px 100px rgba(0,0,0,.6),
    var(--shadow);
  border-radius:18px;
  overflow:hidden;
  position:relative;
}

.scan-shell::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:2px;
  background:linear-gradient(
    90deg,
    transparent,
    var(--green),
    transparent
  );
  animation:topScan 2.6s linear infinite;
}

@keyframes topScan{
  0%{transform:translateX(-100%);opacity:0}
  20%{opacity:1}
  80%{opacity:1}
  100%{transform:translateX(100%);opacity:0}
}

.window-bar{
  height:52px;
  display:flex;
  align-items:center;
  gap:9px;
  padding:0 18px;
  border-bottom:1px solid var(--line);
  background:rgba(255,255,255,.018);
}

.dot{
  width:10px;
  height:10px;
  border-radius:50%;
  background:#253137;
  box-shadow:0 0 8px currentColor;
}

.dot.red{color:#ff667d;background:#ff667d}
.dot.yellow{color:#ffd86b;background:#ffd86b}
.dot.green{color:#73ffc7;background:#73ffc7}

.window-title{
  margin-left:8px;
  color:#76968c;
  font-size:12px;
  letter-spacing:.08em;
}

.scan-content{
  padding:clamp(24px,5vw,60px);
}

.system-label{
  color:var(--green);
  font-size:12px;
  letter-spacing:.22em;
  text-transform:uppercase;
  margin-bottom:15px;
}

.scan-title{
  margin:0;
  font-size:clamp(28px,5vw,62px);
  line-height:1;
  letter-spacing:-.05em;
  font-weight:500;
  color:#edfff8;
}

.scan-title span{
  color:var(--green);
  text-shadow:0 0 25px rgba(115,255,199,.25);
}

.scan-subtitle{
  margin:18px 0 34px;
  color:#719087;
  max-width:780px;
  line-height:1.8;
  font-size:13px;
}

.terminal{
  border:1px solid var(--line);
  background:#030607;
  border-radius:12px;
  overflow:hidden;
  box-shadow:
    inset 0 0 70px rgba(66,232,170,.025),
    0 20px 70px rgba(0,0,0,.3);
}

.terminal-head{
  height:40px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 14px;
  border-bottom:1px solid rgba(115,255,199,.1);
  color:#55756c;
  font-size:11px;
}

.terminal-status{
  color:var(--green);
}

.terminal-body{
  padding:20px;
  min-height:300px;
  position:relative;
  overflow:hidden;
}

.terminal-body::after{
  content:"";
  position:absolute;
  left:0;
  right:0;
  height:80px;
  top:-80px;
  background:linear-gradient(
    to bottom,
    transparent,
    rgba(115,255,199,.05),
    transparent
  );
  animation:terminalSweep 3s linear infinite;
  pointer-events:none;
}

@keyframes terminalSweep{
  from{top:-80px}
  to{top:100%}
}

.log{
  min-height:210px;
  max-height:280px;
  overflow:hidden;
  color:#79aa9b;
  font-size:12px;
  line-height:1.85;
}

.log-line{
  animation:lineIn .18s ease-out both;
}

@keyframes lineIn{
  from{
    opacity:0;
    transform:translateX(-5px);
  }
  to{
    opacity:1;
    transform:none;
  }
}

.log-line .prompt{
  color:#438b73;
}

.log-line .good{
  color:var(--green);
}

.log-line .warn{
  color:var(--yellow);
}

.log-line .danger{
  color:var(--red);
}

.progress-wrap{
  margin-top:22px;
}

.progress-meta{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:9px;
  font-size:11px;
  color:#59776e;
}

#progressPercent{
  color:var(--green);
  font-size:14px;
}

.progress-track{
  width:100%;
  height:12px;
  border:1px solid rgba(115,255,199,.25);
  background:#050a0b;
  padding:2px;
  position:relative;
  overflow:hidden;
}

.progress-bar{
  height:100%;
  width:0%;
  background:
    repeating-linear-gradient(
      90deg,
      var(--green) 0 9px,
      var(--green2) 9px 18px
    );
  box-shadow:
    0 0 14px rgba(115,255,199,.5),
    0 0 30px rgba(115,255,199,.15);
  position:relative;
  transition:width .35s linear;
}

.progress-bar::after{
  content:"";
  position:absolute;
  top:0;
  bottom:0;
  width:100px;
  right:-100px;
  background:linear-gradient(
    90deg,
    transparent,
    rgba(255,255,255,.5),
    transparent
  );
  animation:barShine 1.1s linear infinite;
}

@keyframes barShine{
  from{transform:translateX(-100px)}
  to{transform:translateX(100px)}
}

.scan-info{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
  margin-top:22px;
}

.info-box{
  border:1px solid rgba(115,255,199,.1);
  padding:13px;
  background:rgba(255,255,255,.015);
}

.info-label{
  color:#4e6c64;
  font-size:9px;
  text-transform:uppercase;
  letter-spacing:.15em;
  margin-bottom:7px;
}

.info-value{
  color:#b8d9cf;
  font-size:11px;
}

.scan-message{
  min-height:25px;
  margin-top:20px;
  color:var(--soft);
  font-size:12px;
}

.cursor{
  display:inline-block;
  width:7px;
  height:13px;
  background:var(--green);
  vertical-align:-2px;
  margin-left:3px;
  animation:blink .75s steps(1) infinite;
}

@keyframes blink{
  50%{opacity:0}
}

.scan-footer{
  margin-top:25px;
  display:flex;
  justify-content:space-between;
  gap:15px;
  color:#45645b;
  font-size:10px;
  flex-wrap:wrap;
}

#scanComplete{
  display:none;
  margin-top:25px;
  padding:14px 16px;
  border:1px solid rgba(115,255,199,.3);
  color:var(--green);
  background:rgba(115,255,199,.04);
  text-align:center;
  animation:completePulse 1.5s ease-in-out infinite;
}

@keyframes completePulse{
  50%{
    box-shadow:0 0 30px rgba(115,255,199,.08);
  }
}

/* =========================================================
   REPORT
   ========================================================= */

#report{
  display:none;
  min-height:100vh;
  padding:30px 16px 90px;
  position:relative;
}

.report-shell{
  width:min(1180px,100%);
  margin:0 auto;
}

.report-header{
  border:1px solid var(--line2);
  background:
    linear-gradient(
      135deg,
      rgba(12,28,27,.98),
      rgba(5,10,12,.98)
    );
  padding:clamp(26px,5vw,55px);
  position:relative;
  overflow:hidden;
  box-shadow:0 30px 100px rgba(0,0,0,.5);
}

.report-header::after{
  content:"CONFIDENTIAL // PERSONAL";
  position:absolute;
  right:22px;
  top:22px;
  color:rgba(115,255,199,.35);
  font-size:9px;
  letter-spacing:.2em;
}

.report-kicker{
  color:var(--green);
  font-size:10px;
  letter-spacing:.25em;
  margin-bottom:14px;
}

.report-title{
  margin:0;
  font-size:clamp(32px,6vw,70px);
  line-height:1;
  font-weight:500;
  letter-spacing:-.055em;
}

.report-title span{
  color:var(--green);
}

.report-id{
  margin-top:18px;
  color:#5e7d74;
  font-size:11px;
}

.report-status{
  margin-top:30px;
  display:inline-flex;
  gap:9px;
  align-items:center;
  padding:8px 12px;
  border:1px solid rgba(115,255,199,.25);
  color:var(--green);
  font-size:10px;
  letter-spacing:.1em;
}

.status-dot{
  width:7px;
  height:7px;
  border-radius:50%;
  background:var(--green);
  box-shadow:0 0 12px var(--green);
}

.report-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
  margin-top:14px;
}

.report-section{
  border:1px solid var(--line);
  background:
    linear-gradient(
      180deg,
      rgba(12,20,23,.95),
      rgba(6,11,13,.97)
    );
  padding:24px;
  position:relative;
  overflow:hidden;
}

.report-section.full{
  grid-column:1/-1;
}

.report-section::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  width:50px;
  height:1px;
  background:var(--green);
}

.section-number{
  color:#41645a;
  font-size:9px;
  letter-spacing:.18em;
  margin-bottom:9px;
}

.section-title{
  margin:0 0 17px;
  font-size:18px;
  font-weight:500;
  color:#dcfff3;
}

.section-description{
  color:#78938b;
  line-height:1.8;
  font-size:11px;
  margin-bottom:18px;
}

.metric-list{
  display:grid;
  gap:11px;
}

.metric{
  display:grid;
  grid-template-columns:170px 1fr 52px;
  align-items:center;
  gap:10px;
}

.metric-name{
  color:#91b0a7;
  font-size:10px;
}

.metric-track{
  height:6px;
  background:#101a1d;
  border:1px solid rgba(115,255,199,.08);
  overflow:hidden;
}

.metric-fill{
  height:100%;
  background:linear-gradient(
    90deg,
    #2eaa7f,
    var(--green)
  );
  box-shadow:0 0 10px rgba(115,255,199,.25);
}

.metric-value{
  color:var(--green);
  text-align:right;
  font-size:10px;
}

.trait-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:9px;
}

.trait{
  border:1px solid rgba(115,255,199,.09);
  background:rgba(255,255,255,.015);
  padding:14px;
}

.trait-code{
  color:#3f665b;
  font-size:8px;
  margin-bottom:7px;
}

.trait-name{
  color:#b8d9cf;
  font-size:11px;
  margin-bottom:6px;
}

.trait-text{
  color:#637f77;
  font-size:9px;
  line-height:1.6;
}

.analysis-list{
  display:grid;
  gap:9px;
}

.analysis-row{
  display:grid;
  grid-template-columns:145px 1fr;
  gap:14px;
  padding:11px 0;
  border-bottom:1px dashed rgba(115,255,199,.08);
}

.analysis-row:last-child{
  border-bottom:0;
}

.analysis-label{
  color:var(--green);
  font-size:10px;
}

.analysis-text{
  color:#839e95;
  font-size:10px;
  line-height:1.7;
}

.bug-list{
  display:grid;
  gap:10px;
}

.bug{
  border-left:2px solid var(--red);
  background:rgba(255,113,140,.025);
  padding:12px 14px;
}

.bug-code{
  color:var(--red);
  font-size:9px;
  margin-bottom:5px;
}

.bug-text{
  color:#a0848d;
  font-size:10px;
  line-height:1.6;
}

.ability-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
}

.ability{
  padding:14px;
  border:1px solid rgba(120,191,255,.13);
  background:rgba(120,191,255,.025);
}

.ability-name{
  color:var(--blue);
  font-size:10px;
  margin-bottom:6px;
}

.ability-text{
  color:#718b98;
  font-size:9px;
  line-height:1.6;
}

.observation{
  border-left:2px solid var(--yellow);
  padding:14px 16px;
  background:rgba(255,216,107,.025);
  color:#a8986e;
  font-size:10px;
  line-height:1.8;
  margin-bottom:10px;
}

.observation:last-child{
  margin-bottom:0;
}

.special-table{
  width:100%;
  border-collapse:collapse;
}

.special-table td{
  border-bottom:1px solid rgba(115,255,199,.07);
  padding:12px 7px;
  vertical-align:top;
  font-size:10px;
}

.special-table td:first-child{
  width:38%;
  color:#6e9b8d;
}

.special-table td:last-child{
  color:#b2ccc4;
}

.final-report{
  margin-top:14px;
  border:1px solid rgba(115,255,199,.3);
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(115,255,199,.08),
      transparent 55%
    ),
    #07100f;
  padding:clamp(30px,6vw,65px);
  text-align:center;
  position:relative;
  overflow:hidden;
}

.final-report::before,
.final-report::after{
  content:"";
  position:absolute;
  width:180px;
  height:180px;
  border:1px solid rgba(115,255,199,.08);
  border-radius:50%;
}

.final-report::before{
  left:-100px;
  top:-100px;
}

.final-report::after{
  right:-100px;
  bottom:-100px;
}

.final-label{
  color:#53756a;
  font-size:9px;
  letter-spacing:.25em;
  margin-bottom:18px;
}

.final-title{
  margin:0;
  color:var(--green);
  font-size:clamp(25px,4vw,46px);
  font-weight:500;
  letter-spacing:-.04em;
}

.final-text{
  max-width:700px;
  margin:20px auto 0;
  color:#7f9b92;
  font-size:11px;
  line-height:2;
}

.final-command{
  margin:28px auto 0;
  max-width:650px;
  padding:17px;
  border:1px solid rgba(115,255,199,.15);
  background:#030707;
  color:#a9d7c8;
  font-size:11px;
}

.final-command span{
  color:var(--green);
}

.report-footer{
  text-align:center;
  margin-top:30px;
  color:#38564e;
  font-size:9px;
  letter-spacing:.08em;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media(max-width:800px){
  .report-grid{
    grid-template-columns:1fr;
  }

  .report-section.full{
    grid-column:auto;
  }

  .scan-info{
    grid-template-columns:1fr 1fr;
  }

  .trait-grid{
    grid-template-columns:1fr 1fr;
  }

  .metric{
    grid-template-columns:120px 1fr 45px;
  }
}

@media(max-width:520px){
  #scanner{
    padding:10px;
  }

  #report{
    padding:10px 10px 60px;
  }

  .scan-content{
    padding:22px 16px;
  }

  .window-title{
    display:none;
  }

  .terminal-body{
    padding:13px;
  }

  .log{
    font-size:10px;
  }

  .scan-info{
    grid-template-columns:1fr 1fr;
  }

  .metric{
    grid-template-columns:1fr;
    gap:5px;
  }

  .metric-value{
    text-align:left;
  }

  .trait-grid{
    grid-template-columns:1fr;
  }

  .ability-grid{
    grid-template-columns:1fr;
  }

  .analysis-row{
    grid-template-columns:1fr;
    gap:5px;
  }

  .report-section{
    padding:18px;
  }

  .report-header{
    padding:26px 20px;
  }

  .report-header::after{
    display:none;
  }
}
</style>
</head>

<body>

<!-- =======================================================
     SCANNING INTERFACE
     ======================================================= -->

<section id="scanner">

  <div class="scan-shell">

    <div class="window-bar">
      <div class="dot red"></div>
      <div class="dot yellow"></div>
      <div class="dot green"></div>
      <div class="window-title">
        terminal — vruOS-diagnostic — secure session
      </div>
    </div>

    <div class="scan-content">

      <div class="system-label">
        VRUSHTI_OS // SYSTEM DIAGNOSTICS
      </div>

      <h1 class="scan-title">
        Initializing <span>Personality Scan</span>
      </h1>

      <p class="scan-subtitle">
        Secure diagnostic process initiated. The system is currently
        inspecting behavioural patterns, personality modules, emotional
        responses, food-related dependencies, sleep protocols,
        communication activity and several unexplained anomalies.
      </p>

      <div class="terminal">

        <div class="terminal-head">
          <span>vruOS-diagnostic@localhost:~</span>
          <span class="terminal-status" id="terminalStatus">
            CONNECTING...
          </span>
        </div>

        <div class="terminal-body">

          <div class="log" id="log"></div>

          <div class="progress-wrap">

            <div class="progress-meta">
              <span id="progressLabel">
                Preparing diagnostic engine...
              </span>

              <span id="progressPercent">
                0%
              </span>
            </div>

            <div class="progress-track">
              <div class="progress-bar" id="progressBar"></div>
            </div>

          </div>

          <div class="scan-message">
            <span id="scanMessage">
              Establishing secure connection to VRUSHTI_OS...
            </span>
            <span class="cursor"></span>
          </div>

          <div class="scan-info">

            <div class="info-box">
              <div class="info-label">Target</div>
              <div class="info-value">VRUSHTI_JII</div>
            </div>

            <div class="info-box">
              <div class="info-label">Engine</div>
              <div class="info-value">VruOS-DX 18.10</div>
            </div>

            <div class="info-box">
              <div class="info-label">Mode</div>
              <div class="info-value">DEEP SCAN</div>
            </div>

            <div class="info-box">
              <div class="info-label">Status</div>
              <div class="info-value" id="scanStatus">
                ANALYZING
              </div>
            </div>

          </div>

        </div>
      </div>

      <div id="scanComplete">
        ✓ DIAGNOSTIC COMPLETE — REPORT DECRYPTED
      </div>

      <div class="scan-footer">
        <span>PROCESS: PERSONALITY_ANALYSIS</span>
        <span id="scanBytes">0.00 GB analyzed</span>
        <span>SECURE CONNECTION</span>
      </div>

    </div>
  </div>
</section>


<!-- =======================================================
     FINAL REPORT
     ======================================================= -->

<section id="report">

<div class="report-shell">

  <header class="report-header">

    <div class="report-kicker">
      VRUSHTI_OS // DEEP PERSONALITY DIAGNOSTIC
    </div>

    <h1 class="report-title">
      SYSTEM <span>REPORT</span>
    </h1>

    <div class="report-id">
      CASE ID: VRO-18-10-2008-001 &nbsp; //
      ANALYSIS DEPTH: EXTREME
    </div>

    <div class="report-status">
      <span class="status-dot"></span>
      SUBJECT SUCCESSFULLY IDENTIFIED
    </div>

  </header>


  <!-- CORE METRICS -->

  <div class="report-grid">

    <article class="report-section full">

      <div class="section-number">01 // CORE SYSTEM METRICS</div>

      <h2 class="section-title">
        Primary Personality Configuration
      </h2>

      <p class="section-description">
        The diagnostic engine detected an unusually dense combination
        of cuteness, chaos, emotional expressiveness, food-related
        activity and completely unnecessary levels of adorableness.
        Several values exceeded the normal human operating range.
      </p>

      <div class="metric-list">

        <div class="metric">
          <div class="metric-name">Cuteness Index</div>
          <div class="metric-track"><div class="metric-fill" style="width:99%"></div></div>
          <div class="metric-value">99%</div>
        </div>

