<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Gift 04 · Our Future Blueprint</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Manrope:wght@300;400;500;600&display=swap');

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
margin:0;
background:#f8f3ea;
color:#554d46;
font-family:Manrope,sans-serif;
overflow-x:hidden;
}
body:before{
content:"";
position:fixed;
inset:0;
pointer-events:none;
background:
radial-gradient(circle at 10% 15%,rgba(240,199,174,.35),transparent 27%),
radial-gradient(circle at 88% 25%,rgba(198,220,198,.38),transparent 30%),
radial-gradient(circle at 45% 90%,rgba(216,204,232,.35),transparent 32%);
z-index:-3;
}
.paper{
position:fixed;
inset:0;
opacity:.2;
pointer-events:none;
background-image:
linear-gradient(rgba(130,105,85,.08) 1px,transparent 1px),
linear-gradient(90deg,rgba(130,105,85,.08) 1px,transparent 1px);
background-size:42px 42px;
mask-image:linear-gradient(to bottom,transparent,black 15%,black 85%,transparent);
z-index:-2;
}
.floating{
position:fixed;
width:12px;height:12px;
border-radius:50%;
background:#d9b9a3;
opacity:.25;
animation:float 10s ease-in-out infinite;
pointer-events:none;
}
.f1{left:12%;top:22%}.f2{left:82%;top:35%;animation-delay:2s}.f3{left:67%;top:78%;animation-delay:4s}.f4{left:27%;top:70%;animation-delay:6s}
@keyframes float{50%{transform:translateY(-35px) translateX(20px);opacity:.5}}

.back{
position:fixed;top:18px;left:18px;z-index:40;
padding:10px 15px;
border-radius:999px;
background:rgba(255,253,247,.76);
border:1px solid rgba(95,75,60,.12);
backdrop-filter:blur(12px);
color:#6b6057;
text-decoration:none;
font:500 11px 'DM Sans';
box-shadow:0 8px 28px rgba(90,65,45,.07);
}

.hero{
min-height:82vh;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
padding:100px 20px 50px;
}
.hero-inner{max-width:850px}
.kicker{
font:500 10px 'DM Sans';
letter-spacing:.24em;
color:#a9826b;
text-transform:uppercase;
}
h1{
font-size:clamp(52px,9vw,105px);
font-weight:400;
letter-spacing:-.065em;
line-height:.92;
margin:22px 0;
color:#514a44;
}
.hero p{
max-width:680px;
margin:auto;
font-size:15px;
line-height:1.9;
color:#857a72;
}
.house{
width:110px;height:80px;
margin:45px auto 30px;
position:relative;
animation:housefloat 5s ease-in-out infinite;
}
.house:before{
content:"";
position:absolute;
left:5px;top:25px;
width:100px;height:55px;
border:2px solid #b8947d;
border-top:0;
border-radius:4px;
background:rgba(255,255,255,.38);
}
.house:after{
content:"";
position:absolute;
left:10px;top:3px;
width:76px;height:76px;
border-left:2px solid #b8947d;
border-top:2px solid #b8947d;
transform:rotate(45deg) scale(.72);
background:#f8f3ea;
}
@keyframes housefloat{50%{transform:translateY(-7px)}}
.scroll{
font:500 10px 'DM Sans';
letter-spacing:.18em;
color:#9a8e86;
}

.blueprint{
width:min(1050px,92vw);
margin:auto;
padding:30px 0 110px;
}
.heading{
display:flex;
align-items:end;
justify-content:space-between;
margin-bottom:45px;
gap:20px;
}
.heading h2{
font-size:32px;
font-weight:400;
margin:0;
letter-spacing:-.04em;
}
.heading span{
font:500 10px 'DM Sans';
letter-spacing:.15em;
color:#a99d94;
}

.route{
position:relative;
padding:10px 0;
}
.route:before{
content:"";
position:absolute;
left:50%;
top:0;
bottom:0;
width:2px;
background:linear-gradient(#d8c0ad,#b9cfbd,#c8bdd8,#d8c0ad);
transform:translateX(-50%);
}
.station{
position:relative;
width:50%;
padding:0 50px 75px 0;
}
.station:nth-child(even){
margin-left:50%;
padding:0 0 75px 50px;
}
.node{
position:absolute;
right:-12px;
top:18px;
width:25px;height:25px;
border-radius:50%;
background:#f8f3ea;
border:2px solid #b99580;
box-shadow:0 0 0 7px rgba(185,149,128,.1);
z-index:2;
}
.station:nth-child(even) .node{
left:-12px;
right:auto;
}
.blueprint-piece{
position:relative;
padding:28px;
border:1px solid rgba(100,78,62,.13);
border-radius:24px;
background:rgba(255,253,248,.67);
box-shadow:
0 18px 55px rgba(95,70,50,.07),
inset 0 1px rgba(255,255,255,.85);
transition:.5s cubic-bezier(.2,.8,.2,1);
cursor:pointer;
}
.blueprint-piece:hover{
transform:translateY(-7px) scale(1.015);
box-shadow:0 27px 70px rgba(95,70,50,.12);
border-color:rgba(130,100,80,.24);
}
.plan-mark{
width:58px;height:58px;
border:1px solid var(--accent);
border-radius:18px;
position:relative;
margin-bottom:22px;
background:var(--wash);
}
.plan-mark:before,
.plan-mark:after{
content:"";
position:absolute;
background:var(--accent);
opacity:.7;
}
.plan-mark:before{width:28px;height:1px;left:14px;top:28px}
.plan-mark:after{width:1px;height:28px;left:28px;top:14px}
.station:nth-child(2) .plan-mark{border-radius:50%}
.station:nth-child(3) .plan-mark{transform:rotate(45deg);border-radius:8px}
.station:nth-child(4) .plan-mark{border-radius:8px 22px}
.station:nth-child(5) .plan-mark{border-style:dashed}
.station:nth-child(6) .plan-mark{border-width:2px}
.station:nth-child(7) .plan-mark{border-radius:50% 8px}
.station:nth-child(8) .plan-mark{transform:scale(.85)}
.station:nth-child(9) .plan-mark{border-radius:8px 8px 25px}
.station:nth-child(10) .plan-mark{border-style:dotted}
.station:nth-child(11) .plan-mark{transform:rotate(-20deg)}
.station:nth-child(12) .plan-mark{border-radius:50% 20%}
.station:nth-child(13) .plan-mark{border-width:3px}
.station:nth-child(14) .plan-mark{border-radius:25%}
.station:nth-child(15) .plan-mark{transform:rotate(20deg) scale(.9)}
.station:nth-child(16) .plan-mark{border-radius:50%}
.station:nth-child(17) .plan-mark{border-style:dashed;border-radius:5px}
.station:nth-child(18) .plan-mark{transform:rotate(-10deg);border-width:2px}

.phase{
font:500 10px 'DM Sans';
letter-spacing:.15em;
color:#a88874;
margin-bottom:10px;
}
.blueprint-piece h3{
font-size:23px;
font-weight:500;
line-height:1.25;
margin:0 0 10px;
color:#584f48;
}
.blueprint-piece p{
font-size:13px;
line-height:1.75;
margin:0;
color:#877c74;
}
.detail-line{
margin-top:18px;
padding-top:13px;
border-top:1px solid rgba(100,78,62,.08);
font-size:11px;
color:#a0958d;
}

.closing{
margin:30px auto 0;
padding:40px;
width:min(850px,92vw);
text-align:center;
border:1px solid rgba(100,78,62,.12);
border-radius:30px;
background:rgba(255,253,248,.62);
}
.closing h2{
font-size:34px;
font-weight:400;
margin:0 0 15px;
}
.closing p{
font-size:14px;
line-height:1.9;
color:#877c74;
max-width:650px;
margin:auto;
}
.status{
display:inline-block;
margin-top:25px;
padding:10px 15px;
border:1px solid rgba(169,130,107,.25);
border-radius:999px;
font:500 9px 'DM Sans';
letter-spacing:.15em;
color:#a9826b;
}

.modal{
position:fixed;
inset:0;
display:none;
place-items:center;
padding:20px;
background:rgba(75,62,55,.18);
backdrop-filter:blur(18px);
z-index:100;
}
.modal.open{display:grid}
.window{
width:min(680px,94vw);
max-height:88vh;
overflow:auto;
padding:38px;
border-radius:30px;
background:rgba(255,253,248,.92);
border:1px solid rgba(100,78,62,.14);
box-shadow:0 40px 120px rgba(70,50,40,.18);
animation:windowin .5s cubic-bezier(.2,.8,.2,1);
}
@keyframes windowin{from{opacity:0;transform:translateY(25px) scale(.96)}to{opacity:1;transform:none}}
.window-top{
display:flex;
justify-content:space-between;
align-items:center;
font:500 10px 'DM Sans';
letter-spacing:.14em;
color:#a08f84;
}
.close{
width:32px;height:32px;
border:0;border-radius:50%;
background:#eee4dc;
color:#75675e;
cursor:pointer;
font-size:17px;
}
.window h2{
font-size:42px;
font-weight:400;
line-height:1.05;
letter-spacing:-.045em;
margin:25px 0 15px;
}
.window p{
font-size:15px;
line-height:1.9;
color:#81766f;
}
.specs{
display:grid;
grid-template-columns:1fr 1fr;
gap:12px;
margin-top:25px;
}
.spec{
padding:16px;
background:#f7f0e9;
border-radius:16px;
}
.spec small{
display:block;
font:500 9px 'DM Sans';
letter-spacing:.12em;
color:#a89589;
margin-bottom:7px;
}
.spec span{
font-size:13px;
color:#665d56;
line-height:1.5;
}
footer{
padding:30px;
text-align:center;
font:500 10px 'DM Sans';
letter-spacing:.13em;
color:#aaa097;
}

@media(max-width:760px){
.route:before{left:10px}
.station,.station:nth-child(even){
width:100%;
margin:0;
padding:0 0 45px 45px;
}
.node,.station:nth-child(even) .node{
left:-2px;
right:auto;
}
}
@media(max-width:570px){
.window{padding:25px}
.specs{grid-template-columns:1fr}
}
</style>




