<script id="gift04-final-particle-engine">
(() => {

    function createBackground() {

        /* Remove previous generated layer */
        document.querySelectorAll(".gift04-background-particles")
            .forEach(el => el.remove());

        const layer = document.createElement("div");

        layer.className = "gift04-background-particles";

        layer.setAttribute(
            "aria-hidden",
            "true"
        );

        /*
         * Put the layer directly under the main content.
         * It is deliberately not attached to a card.
         */
        document.body.prepend(layer);


        /*
         * Many particles.
         *
         * They intentionally have:
         * - different sizes
         * - different positions
         * - different opacity
         * - different speeds
         * - different movement distances
         */
        const COUNT = 72;

        const colors = [
            "rgba(92,113,105,.34)",
            "rgba(126,145,138,.27)",
            "rgba(174,158,137,.22)",
            "rgba(111,131,122,.25)",
            "rgba(198,183,161,.20)"
        ];


        for (let i = 0; i < COUNT; i++) {

            const particle = document.createElement("span");

            particle.className = "bg-particle";


            const size =
                2 +
                Math.random() * 4;


            const opacity =
                0.16 +
                Math.random() * 0.28;


            const left =
                Math.random() * 100;


            /*
             * Spread particles over the whole page
             * instead of putting them all inside the viewport.
             */
            const top =
                Math.random() * 100;


            const duration =
                5 +
                Math.random() * 9;


            const delay =
                Math.random() * -12;


            const x =
                (Math.random() * 30 + 10).toFixed(1) +
                "px";


            const y =
                (Math.random() * 24 + 8).toFixed(1) +
                "px";


            particle.style.setProperty(
                "--particle-size",
                size.toFixed(1) + "px"
            );

            particle.style.setProperty(
                "--particle-opacity",
                opacity.toFixed(2)
            );

            particle.style.setProperty(
                "--particle-left",
                left.toFixed(2) + "%"
            );

            particle.style.setProperty(
                "--particle-top",
                top.toFixed(2) + "%"
            );

            particle.style.setProperty(
                "--particle-duration",
                duration.toFixed(2) + "s"
            );

            particle.style.setProperty(
                "--particle-delay",
                delay.toFixed(2) + "s"
            );

            particle.style.setProperty(
                "--particle-x",
                x
            );

            particle.style.setProperty(
                "--particle-y",
                y
            );

            particle.style.setProperty(
                "--particle-color",
                colors[
                    Math.floor(
                        Math.random() * colors.length
                    )
                ]
            );


            layer.appendChild(particle);
        }


        /*
         * Subtle scroll-parallax.
         *
         * The particles remain in the background,
         * but their layer moves very slightly as the user scrolls.
         * This prevents them from feeling glued to the viewport.
         */
        let ticking = false;

        function updateParallax() {

            const scrollY =
                window.scrollY || window.pageYOffset || 0;

            const movement =
                scrollY * 0.045;

            layer.style.transform =
                `translate3d(0, ${movement}px, 0)`;

            ticking = false;
        }


        window.addEventListener(
            "scroll",
            () => {

                if (!ticking) {

                    window.requestAnimationFrame(
                        updateParallax
                    );

                    ticking = true;
                }
            },
            { passive: true }
        );


        updateParallax();
    }


    if (document.readyState === "loading") {

        document.addEventListener(
            "DOMContentLoaded",
            createBackground
        );

    } else {

        createBackground();
    }

})();
</script>


<script id="gift04-whole-document-particles-and-route">

(() => {

    function setupParticles() {

        let layer =
            document.querySelector(
                ".gift04-background-particles"
            );

        if (!layer) {

            layer = document.createElement("div");

            layer.className =
                "gift04-background-particles";

            layer.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.prepend(layer);
        }


        /* Clear old generated particles */
        layer.innerHTML = "";


        /*
         * Enough particles to make the background feel alive,
         * but intentionally subtle.
         */
        const COUNT = 85;

        const colors = [
            "rgba(78,96,89,.20)",
            "rgba(103,119,112,.17)",
            "rgba(144,133,115,.14)",
            "rgba(88,108,99,.15)",
            "rgba(170,157,136,.12)"
        ];


        for (let i = 0; i < COUNT; i++) {

            const particle =
                document.createElement("span");

            particle.className =
                "bg-particle";


            const size =
                1.5 + Math.random() * 3.5;

            const opacity =
                .16 + Math.random() * .18;

            const left =
                Math.random() * 100;

            /*
             * IMPORTANT:
             * Position against the whole document,
             * not only the current viewport.
             */
            const documentHeight =
                Math.max(
                    document.documentElement.scrollHeight,
                    document.body.scrollHeight
                );

            const top =
                Math.random() * documentHeight;


            const duration =
                7 + Math.random() * 12;

            const delay =
                Math.random() * -15;

            const x =
                (8 + Math.random() * 26)
                .toFixed(1) + "px";

            const y =
                (5 + Math.random() * 22)
                .toFixed(1) + "px";


            particle.style.setProperty(
                "--particle-size",
                size + "px"
            );

            particle.style.setProperty(
                "--particle-opacity",
                opacity
            );

            particle.style.setProperty(
                "--particle-left",
                left + "%"
            );

            particle.style.setProperty(
                "--particle-top",
                top + "px"
            );

            particle.style.setProperty(
                "--particle-duration",
                duration + "s"
            );

            particle.style.setProperty(
                "--particle-delay",
                delay + "s"
            );

            particle.style.setProperty(
                "--particle-x",
                x
            );

            particle.style.setProperty(
                "--particle-y",
                y
            );

            particle.style.setProperty(
                "--particle-color",
                colors[
                    Math.floor(
                        Math.random() *
                        colors.length
                    )
                ]
            );


            layer.appendChild(particle);
        }


        function resizeLayer() {

            const height =
                Math.max(
                    document.documentElement.scrollHeight,
                    document.body.scrollHeight
                );

            layer.style.setProperty(
                "--gift04-document-height",
                height + "px"
            );

            layer.style.height =
                height + "px";
        }


        resizeLayer();

        window.addEventListener(
            "resize",
            resizeLayer,
            { passive: true }
        );


        /*
         * Very subtle document parallax.
         * The particles do NOT stick to the viewport.
         */
        let ticking = false;

        window.addEventListener(
            "scroll",
            () => {

                if (ticking) return;

                ticking = true;

                requestAnimationFrame(() => {

                    const y =
                        window.scrollY * 0.025;

                    layer.style.transform =
                        `translate3d(0, ${y}px, 0)`;

                    ticking = false;
                });
            },
            { passive: true }
        );
    }


    // ========================================================
    // CREATE THE MIDDLE STOP/NODE FOR EVERY BLUEPRINT ITEM
    // ========================================================

    function setupRouteNodes() {

        const selectors = [
            ".blueprint-station",
            ".blueprint-card",
            ".plan-card",
            ".future-card",
            ".station-card",
            ".route-card",
            ".station"
        ];


        let items = [];

        for (const selector of selectors) {

            const found =
                [...document.querySelectorAll(selector)];

            if (found.length >= 8) {

                items = found;
                break;
            }
        }


        if (!items.length) return;


        /*
         * Prevent duplicate nodes.
         */
        document
            .querySelectorAll(".gift04-route-node")
            .forEach(n => n.remove());

        document
            .querySelectorAll(".gift04-route-connector")
            .forEach(n => n.remove());


        /*
         * Every card gets exactly one central stop.
         */
        items.forEach((item) => {

            item.style.position = "relative";


            const node =
                document.createElement("span");

            node.className =
                "gift04-route-node";

            node.setAttribute(
                "aria-hidden",
                "true"
            );


            item.appendChild(node);
        });
    }


    function refreshEverything() {

        setupParticles();

        /*
         * Wait one frame so existing page layout has settled.
         */
        requestAnimationFrame(() => {

            setupRouteNodes();

        });
    }


    if (document.readyState === "loading") {

        document.addEventListener(
            "DOMContentLoaded",
            refreshEverything
        );

    } else {

        refreshEverything();
    }


    window.addEventListener(
        "load",
        () => {

            setTimeout(
                refreshEverything,
                150
            );

        },
        { once: true }
    );

})();

</script>


<script id="gift04-final-tree-engine">

(() => {

    function getItems() {

        const selectors = [
            ".blueprint-card",
            ".plan-card",
            ".future-card",
            ".station-card",
            ".route-card",
            ".blueprint-station",
            ".station"
        ];

        for (const selector of selectors) {

            const items =
                [...document.querySelectorAll(selector)];

            /*
             * The actual blueprint has 18 items.
             * Use the first selector that gives us a meaningful
             * collection rather than combining unrelated elements.
             */
            if (items.length >= 12) {
                return items;
            }
        }

        return [];
    }


    function buildTree() {

        const items = getItems();

        if (!items.length) {
            return;
        }


        /*
         * Remove EVERYTHING created by previous versions.
         */

        document
            .querySelectorAll(
                ".gift04-route-node," +
                ".gift04-route-connector," +
                ".gift04-tree-node," +
                ".gift04-tree-branch"
            )
            .forEach(el => el.remove());


        /*
         * Every card receives exactly ONE branch.
         *
         * There are intentionally ZERO circles.
         */
        items.forEach((item, index) => {

            const branch =
                document.createElement("span");

            branch.className =
                "gift04-tree-branch";

            branch.setAttribute(
                "aria-hidden",
                "true"
            );


            /*
             * The branch crosses only the empty area
             * between the central spine and the card.
             */
            if (window.innerWidth >= 760) {

                if (index % 2 === 0) {

                    branch.style.left = "0";
                    branch.style.width = "50%";

                } else {

                    branch.style.left = "50%";
                    branch.style.width = "50%";
                }
            }


            item.appendChild(branch);
        });
    }


    /*
     * Run after the page has fully settled.
     */

    function start() {

        requestAnimationFrame(() => {

            requestAnimationFrame(() => {

                buildTree();

            });

        });
    }


    if (document.readyState === "loading") {

        document.addEventListener(
            "DOMContentLoaded",
            start,
            { once: true }
        );

    } else {

        start();
    }


    window.addEventListener(
        "load",
        () => {

            setTimeout(
                buildTree,
                200
            );

        },
        { once: true }
    );


    window.addEventListener(
        "resize",
        () => {

            clearTimeout(
                window.__gift04TreeResize
            );

            window.__gift04TreeResize =
                setTimeout(
                    buildTree,
                    100
                );

        },
        { passive: true }
    );

})();

</script>

