<style id="gift04-final-background-and-hero-fix">

/* ==========================================================
   1. REMOVE THE OLD HOUSE / ARCHITECTURAL HERO ART
   ========================================================== */

/* Anything explicitly named as house/architecture */
[class*="house"],
[id*="house"],
[class*="House"],
[id*="House"],
[class*="architecture"],
[id*="architecture"],
[class*="Architecture"],
[id*="Architecture"],
[class*="house-icon"],
[id*="house-icon"],
[class*="home-icon"],
[id*="home-icon"] {
    display: none !important;
}


/* Old blueprint illustration containers */
[class*="hero-art"],
[id*="hero-art"],
[class*="heroArt"],
[id*="heroArt"],
[class*="hero-mark"],
[id*="hero-mark"],
[class*="heroMark"],
[id*="heroMark"] {
    background: none !important;
    background-image: none !important;
}


/* SVG artwork inside the Gift 04 hero */
.hero svg,
.hero-section svg,
.hero-area svg,
.hero-visual svg,
.hero-illustration svg,
.blueprint-hero svg,
.future-hero svg,
.future-blueprint svg {
    display: none !important;
}


/* Explicitly kill common old house line elements */
.house-line,
.house-roof,
.house-wall,
.house-outline,
.blueprint-house,
.blueprint-house-icon,
.architecture-mark,
.home-outline,
.roof-line {
    display: none !important;
}


/* ==========================================================
   2. CLEAN HERO AREA
   ========================================================== */

.gift04-hero-logo,
.blueprint-hero-logo,
.future-blueprint-logo,
.hero-logo,
.hero-mark,
.hero-icon {
    background: transparent !important;
    background-image: none !important;

    border: 0 !important;
    box-shadow: none !important;

    outline: none !important;

    transform: none !important;
}


/* Remove previous logo pseudo-artwork */
.gift04-hero-logo::before,
.gift04-hero-logo::after,
.blueprint-hero-logo::before,
.blueprint-hero-logo::after,
.future-blueprint-logo::before,
.future-blueprint-logo::after,
.hero-logo::before,
.hero-logo::after,
.hero-mark::before,
.hero-mark::after,
.hero-icon::before,
.hero-icon::after {
    content: none !important;
}


/* ==========================================================
   3. NEW PARTICLE BACKGROUND
   ========================================================== */

.gift04-background-particles {

    position: absolute !important;

    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;

    min-height: 100% !important;

    overflow: hidden !important;

    pointer-events: none !important;

    z-index: 0 !important;

    isolation: isolate !important;
}


/* Individual particles */

.gift04-background-particles .bg-particle {

    position: absolute !important;

    display: block !important;

    border-radius: 50% !important;

    pointer-events: none !important;

    user-select: none !important;

    opacity: var(--particle-opacity) !important;

    width: var(--particle-size) !important;
    height: var(--particle-size) !important;

    left: var(--particle-left) !important;
    top: var(--particle-top) !important;

    background: var(--particle-color) !important;

    box-shadow:
        0 0 0 1px rgba(255,255,255,.22),
        0 0 12px rgba(92,113,105,.07) !important;

    animation:
        gift04ParticleFloat
        var(--particle-duration)
        var(--particle-delay)
        ease-in-out
        infinite alternate !important;

    will-change: transform !important;
}


/* Very subtle floating motion */

@keyframes gift04ParticleFloat {

    0% {
        transform:
            translate3d(
                calc(var(--particle-x) * -1),
                calc(var(--particle-y) * -1),
                0
            )
            scale(.88);
    }

    50% {
        transform:
            translate3d(0,0,0)
            scale(1);
    }

    100% {
        transform:
            translate3d(
                var(--particle-x),
                var(--particle-y),
                0
            )
            scale(1.08);
    }
}


/* ==========================================================
   4. EVERYTHING IMPORTANT STAYS ABOVE PARTICLES
   ========================================================== */

body > *:not(.gift04-background-particles) {
    position: relative;
    z-index: 1;
}


