}


/* ==========================================================
   PIECE OBJECT
========================================================== */

function createPiece(index){

  const col =
    index % COLS;

  const row =
    Math.floor(index / COLS);

  const piece =
    document.createElement("div");

  piece.className = "piece";

  piece.dataset.index =
    index;

  piece.dataset.locked =
    "false";

  piece.style.setProperty(
    "--rotation",
    `${randomRotation()}deg`
  );

  piece.style.setProperty(
    "--scale",
    "1"
  );

  piece.style.setProperty(
    "--clip",
    makeClipPath(index)
  );

  piece.innerHTML = `
    <div
      class="piece-image"
      style="
        --art:url('${ART}');
        --bgx:-${col * 140}px;
        --bgy:-${row * 120}px;
      "
    ></div>

    <div class="piece-number">
      ${String(index + 1).padStart(2,"0")}
    </div>

