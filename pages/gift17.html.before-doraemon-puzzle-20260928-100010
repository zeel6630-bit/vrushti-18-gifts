<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<meta name="theme-color" content="#10172b">
<meta name="apple-mobile-web-app-capable" content="yes">

<title>Gift 17 · The Missing Pieces</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap');

:root{
  --bg:#07101f;
  --bg2:#101a30;
  --panel:rgba(255,255,255,.065);
  --panel2:rgba(255,255,255,.10);
  --line:rgba(255,255,255,.13);

  --white:#f7f9ff;
  --muted:#9da8bc;

  --blue:#8bd8ff;
  --cyan:#79f0e1;
  --purple:#b6a2ff;
  --pink:#ff9fc9;
  --gold:#ffe19a;

  --piece-width:140px;
  --piece-height:120px;

  --board-width:840px;
  --board-height:360px;

  --shadow:0 35px 90px rgba(0,0,0,.45);
}

*{
  box-sizing:border-box;
}

html{
  min-height:100%;
  scroll-behavior:smooth;
}

body{
  margin:0;
  min-height:100vh;
  overflow-x:hidden;

  font-family:"DM Sans",sans-serif;
  color:var(--white);

  background:
    radial-gradient(circle at 12% 8%,rgba(139,216,255,.13),transparent 25%),
    radial-gradient(circle at 85% 12%,rgba(182,162,255,.13),transparent 26%),
    radial-gradient(circle at 50% 95%,rgba(121,240,225,.09),transparent 30%),
    linear-gradient(145deg,var(--bg),var(--bg2));
}

button{
  font:inherit;
}

button:focus-visible{
  outline:2px solid var(--cyan);
  outline-offset:3px;
}

::selection{
  background:rgba(139,216,255,.25);
}

/* =========================================================
   AMBIENT BACKGROUND
========================================================= */

#ambient{
  position:fixed;
  inset:0;
  overflow:hidden;
  pointer-events:none;
  z-index:0;
}

.ambient-orb{
  position:absolute;
  width:var(--size);
  height:var(--size);
  left:var(--x);
  top:var(--y);

  border-radius:50%;

  background:
    radial-gradient(
      circle at 35% 30%,
      rgba(255,255,255,.08),
      rgba(255,255,255,.015) 55%,
      transparent 70%
    );

  border:1px solid rgba(255,255,255,.025);

  filter:blur(.5px);

  animation:
    orbFloat var(--duration) ease-in-out var(--delay) infinite alternate;
}

@keyframes orbFloat{
  from{
    transform:translate3d(0,0,0) scale(.95);
  }
  to{
    transform:translate3d(var(--mx),var(--my),0) scale(1.08);
  }
}

.dust{
  position:absolute;
  width:var(--size);
  height:var(--size);

  left:var(--x);
  top:-10px;

  border-radius:50%;

  background:var(--color);

  opacity:var(--opacity);

  box-shadow:
    0 0 8px var(--color);

  animation:
    dustFall var(--duration) linear var(--delay) infinite;
}

@keyframes dustFall{
  0%{
    transform:translate3d(0,-10vh,0);
    opacity:0;
  }

  10%{
    opacity:var(--opacity);
  }

  80%{
    opacity:var(--opacity);
  }

  100%{
    transform:translate3d(var(--drift),110vh,0);
    opacity:0;
  }
}

/* =========================================================
   MAIN
========================================================= */

.page{
  position:relative;
  z-index:2;

  width:min(1240px,94vw);

  margin:0 auto;

  padding:
    26px
    0
    70px;
}

/* =========================================================
   HEADER
========================================================= */

.topbar{
  display:flex;
  align-items:center;
  justify-content:space-between;

  gap:15px;

  margin-bottom:35px;
}

.gift-label{
  display:flex;
  align-items:center;
  gap:9px;

  font-size:11px;
  font-weight:800;

  letter-spacing:.18em;
  text-transform:uppercase;

  color:#b7c1d4;
}

.gift-dot{
  width:8px;
  height:8px;

  border-radius:50%;

  background:var(--cyan);

  box-shadow:
    0 0 12px rgba(121,240,225,.9);
}

.back-button{
  border:1px solid var(--line);

  background:rgba(255,255,255,.055);

  color:#e9edf6;

  padding:9px 15px;

  border-radius:999px;

  cursor:pointer;

  backdrop-filter:blur(15px);

  transition:
    transform .2s ease,
    background .2s ease,
    border-color .2s ease;
}

.back-button:hover{
  transform:translateY(-2px);

  background:rgba(255,255,255,.09);

  border-color:rgba(255,255,255,.22);
}

/* =========================================================
   HERO
========================================================= */

.hero{
  text-align:center;

  max-width:850px;

  margin:0 auto;

  padding:
    10px
    10px
    28px;
}

.hero-symbol{
  width:72px;
  height:72px;

  margin:0 auto 17px;

  display:grid;
  place-items:center;

  border-radius:24px;

  font-size:33px;

  background:
    linear-gradient(
      145deg,
      rgba(139,216,255,.13),
      rgba(182,162,255,.14)
    );

  border:1px solid rgba(255,255,255,.13);

  box-shadow:
    0 20px 55px rgba(0,0,0,.25),
    inset 0 0 25px rgba(255,255,255,.04);

  animation:
    symbolFloat 4s ease-in-out infinite;
}

@keyframes symbolFloat{
  0%,100%{
    transform:translateY(0) rotate(-2deg);
  }

  50%{
    transform:translateY(-7px) rotate(2deg);
  }
}

.hero h1{
  margin:0;

  font-family:"Outfit",sans-serif;

  font-size:
    clamp(
      42px,
      7vw,
      78px
    );

  line-height:.96;

  letter-spacing:-.055em;

  font-weight:700;

  background:
    linear-gradient(
      100deg,
      #ffffff 5%,
      #ccecff 36%,
      #c8b9ff 67%,
      #ffbdd8 100%
    );

  -webkit-background-clip:text;
  background-clip:text;

  color:transparent;
}

.hero-description{
  margin:
    19px
    auto
    0;

  max-width:660px;

  color:#aeb9ca;

  font-size:14px;

  line-height:1.75;
}

.hero-note{
  margin-top:11px;

  color:#707c91;

  font-size:11px;

  letter-spacing:.05em;
}

/* =========================================================
   GAME HUD
========================================================= */

.hud{
  display:flex;

  justify-content:center;

  gap:12px;

  flex-wrap:wrap;

  margin:
    8px
    auto
    22px;
}

.hud-card{
  min-width:145px;

  padding:
    11px
    16px;

  text-align:center;

  border-radius:16px;

  background:
    rgba(255,255,255,.055);

  border:
    1px solid rgba(255,255,255,.10);

  backdrop-filter:blur(15px);

  box-shadow:
    0 10px 30px rgba(0,0,0,.15);
}

.hud-label{
  display:block;

  color:#7f8ca2;

  font-size:9px;

  font-weight:800;

  letter-spacing:.14em;

  text-transform:uppercase;

  margin-bottom:4px;
}

.hud-value{
  display:block;

  color:#eef3fb;

  font-family:"Outfit",sans-serif;

  font-size:20px;

  font-weight:700;
}

#progressValue{
  color:var(--cyan);
}

/* =========================================================
   GAME AREA
========================================================= */

.game-shell{
  position:relative;

  padding:
    24px;

  border-radius:32px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.075),
      rgba(255,255,255,.035)
    );

  border:
    1px solid rgba(255,255,255,.12);

  box-shadow:
    var(--shadow);

  backdrop-filter:blur(25px);
}

/* =========================================================
   PUZZLE BOARD
========================================================= */

.board-title{
  display:flex;

  align-items:center;
  justify-content:space-between;

  gap:15px;

  margin-bottom:14px;
}

.board-title-left{
  color:#b9c4d5;

  font-size:11px;

  font-weight:800;

  letter-spacing:.13em;

  text-transform:uppercase;
}

.board-status{
  color:#6f7c91;

  font-size:11px;
}

.board-wrap{
  display:flex;

  justify-content:center;

  width:100%;

  overflow:auto;

  padding:
    14px
    8px
    20px;

  scrollbar-width:thin;
}

.board{
  position:relative;

  flex:none;

  width:var(--board-width);
  height:var(--board-height);

  border-radius:22px;

  overflow:visible;

  background:
    linear-gradient(
      145deg,
      #121d32,
      #0c1527
    );

  border:
    1px solid rgba(255,255,255,.16);

  box-shadow:
    inset 0 0 0 8px rgba(0,0,0,.14),
    inset 0 0 45px rgba(0,0,0,.3),
    0 25px 60px rgba(0,0,0,.35);
}

/* Empty puzzle grooves */

.slot{
  position:absolute;

  width:var(--piece-width);
  height:var(--piece-height);

  left:var(--x);
  top:var(--y);

  border-radius:10px;

  background:
    linear-gradient(
      145deg,
      rgba(0,0,0,.20),
      rgba(255,255,255,.025)
    );

  box-shadow:
    inset 0 3px 7px rgba(0,0,0,.35),
    inset 0 -2px 5px rgba(255,255,255,.025);

  border:
    1px dashed rgba(255,255,255,.07);

  pointer-events:none;
}

/* =========================================================
   PUZZLE PIECES
========================================================= */

.piece{
  position:absolute;

  width:var(--piece-width);
  height:var(--piece-height);

  left:0;
  top:0;

  cursor:grab;

  user-select:none;
  touch-action:none;

  transform:
    translate3d(
      var(--px),
      var(--py),
      0
    )
    rotate(var(--rotation))
    scale(var(--scale));

  transform-origin:center;

  z-index:20;

  transition:
    box-shadow .18s ease,
    filter .18s ease;

  filter:
    drop-shadow(
      0 15px 12px rgba(0,0,0,.28)
    );
}

.piece.dragging{
  cursor:grabbing;

  z-index:500!important;

  filter:
    drop-shadow(
      0 26px 18px rgba(0,0,0,.42)
    );

  --scale:1.055!important;

  transition:none;
}

.piece.locked{
  cursor:default;

  z-index:15!important;

  filter:
    drop-shadow(
      0 5px 5px rgba(0,0,0,.22)
    );

  --scale:1!important;

  transition:
    transform .22s cubic-bezier(.2,.8,.2,1),
    filter .25s ease;
}

.piece-image{
  position:absolute;

  inset:0;

  overflow:hidden;

  border-radius:13px;

  background-repeat:no-repeat;

  background-image:var(--art);

  background-size:
    var(--board-width)
    var(--board-height);

  background-position:
    var(--bgx)
    var(--bgy);

  clip-path:var(--clip);

  border:
    1px solid rgba(255,255,255,.35);

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.30),
    inset 0 -10px 18px rgba(0,0,0,.08);
}

.piece-image:before{
  content:"";

  position:absolute;

  inset:0;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.20),
      transparent 28%,
      transparent 72%,
      rgba(0,0,0,.18)
    );

  pointer-events:none;
}

.piece-image:after{
  content:"";

  position:absolute;

  inset:0;

  border:
    1px solid rgba(255,255,255,.22);

  border-radius:13px;

  pointer-events:none;
}

.piece-number{
  position:absolute;

  left:9px;
  bottom:8px;

  z-index:4;

  width:23px;
  height:23px;

  display:grid;
  place-items:center;

  border-radius:8px;

  background:
    rgba(5,10,20,.56);

  border:
    1px solid rgba(255,255,255,.18);

  color:#f4f7ff;

  font-size:9px;

  font-weight:800;

  backdrop-filter:blur(8px);

  pointer-events:none;
}

.piece.locked .piece-number{
  background:
    rgba(121,240,225,.72);

  color:#06151a;

  border-color:
    rgba(121,240,225,.9);
}

.lock-check{
  position:absolute;

  right:8px;
  top:8px;

  z-index:5;

  width:22px;
  height:22px;

  display:grid;
  place-items:center;

  border-radius:50%;

  background:
    rgba(121,240,225,.90);

  color:#06151a;

  font-size:12px;

  font-weight:900;

  opacity:0;

  transform:scale(.5);

  transition:
    opacity .25s ease,
    transform .25s ease;

  pointer-events:none;
}

.piece.locked .lock-check{
  opacity:1;

  transform:scale(1);
}

/* =========================================================
   PIECE TRAY
========================================================= */

.tray-title{
  display:flex;

  align-items:center;
  justify-content:space-between;

  margin:
    12px
    2px
    10px;
}

.tray-title span:first-child{
  color:#b9c4d5;

  font-size:11px;

  font-weight:800;

  letter-spacing:.13em;

  text-transform:uppercase;
}

.tray-title span:last-child{
  color:#68758a;

  font-size:10px;
}

.tray{
  position:relative;

  min-height:270px;

  border-radius:23px;

  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(139,216,255,.045),
      transparent 55%
    ),
    rgba(0,0,0,.12);

  border:
    1px solid rgba(255,255,255,.07);

  overflow:hidden;
}

/* =========================================================
   CONTROLS
========================================================= */

.controls{
  display:flex;

  justify-content:center;

  align-items:center;

  flex-wrap:wrap;

  gap:10px;

  margin-top:19px;
}

.control-button{
  border:
    1px solid rgba(255,255,255,.12);

  background:
    rgba(255,255,255,.06);

  color:#e8edf6;

  padding:
    11px
    17px;

  border-radius:14px;

  cursor:pointer;

  transition:
    transform .2s ease,
    background .2s ease,
    border-color .2s ease;
}

.control-button:hover{
  transform:translateY(-2px);

  background:
    rgba(255,255,255,.10);

  border-color:
    rgba(255,255,255,.20);
}

.control-button.primary{
  color:#07131b;

  border:0;

  background:
    linear-gradient(
      135deg,
      var(--cyan),
      var(--blue)
    );

  font-weight:800;

  box-shadow:
    0 12px 28px rgba(121,240,225,.15);
}

.control-button:disabled{
  opacity:.35;

  cursor:not-allowed;

  transform:none;
}

/* =========================================================
   INSTRUCTIONS
========================================================= */

.instructions{
  display:grid;

  grid-template-columns:
    repeat(3,1fr);

  gap:11px;

  margin-top:16px;
}

.instruction{
  padding:14px;

  border-radius:17px;

  background:
    rgba(255,255,255,.04);

  border:
    1px solid rgba(255,255,255,.07);
}

.instruction-icon{
  font-size:20px;

  margin-bottom:7px;
}

.instruction-title{
  color:#e7edf6;

  font-size:12px;

  font-weight:700;

  margin-bottom:4px;
}

.instruction-text{
  color:#7f8b9f;

  font-size:10px;

  line-height:1.55;
}

/* =========================================================
   COMPLETION
========================================================= */

.completion{
  position:fixed;

  inset:0;

  z-index:1000;

  display:none;

  align-items:center;
  justify-content:center;

  padding:20px;

  background:
    rgba(4,7,15,.74);

  backdrop-filter:
    blur(18px);
}

.completion.show{
  display:flex;

  animation:
    overlayIn .35s ease both;
}

@keyframes overlayIn{
  from{opacity:0}
  to{opacity:1}
}

.completion-card{
  position:relative;

  width:min(650px,92vw);

  padding:
    42px
    30px
    34px;

  text-align:center;

  border-radius:32px;

  background:
    linear-gradient(
      145deg,
      rgba(27,40,64,.96),
      rgba(17,26,45,.97)
    );

  border:
    1px solid rgba(255,255,255,.16);

  box-shadow:
    0 40px 120px rgba(0,0,0,.6);

  overflow:hidden;

  animation:
    completionCard .55s cubic-bezier(.2,.8,.2,1) both;
}

@keyframes completionCard{
  from{
    transform:
      translateY(25px)
      scale(.94);

    opacity:0;
  }

  to{
    transform:
      translateY(0)
      scale(1);

    opacity:1;
  }
}

.completion-card:before{
  content:"";

  position:absolute;

  width:330px;
  height:330px;

  left:50%;
  top:-250px;

  transform:translateX(-50%);

  border-radius:50%;

  background:
    radial-gradient(
      circle,
      rgba(121,240,225,.24),
      transparent 70%
    );

  filter:blur(8px);
}

.completion-symbol{
  position:relative;

  width:82px;
  height:82px;

  margin:0 auto 18px;

  display:grid;
  place-items:center;

  border-radius:27px;

  font-size:38px;

  background:
    linear-gradient(
      135deg,
      rgba(121,240,225,.18),
      rgba(139,216,255,.14)
    );

  border:
    1px solid rgba(121,240,225,.25);

  box-shadow:
    0 0 50px rgba(121,240,225,.12);

  animation:
    completionSymbol 2s ease-in-out infinite;
}

@keyframes completionSymbol{
  0%,100%{
    transform:translateY(0) rotate(-2deg);
  }

  50%{
    transform:translateY(-6px) rotate(2deg);
  }
}

.completion-card h2{
  position:relative;

  margin:0;

  font-family:"Outfit",sans-serif;

  font-size:
    clamp(38px,6vw,60px);

  line-height:1;

  letter-spacing:-.045em;
}

.completion-card p{
  position:relative;

  max-width:500px;

  margin:
    17px
    auto
    0;

  color:#aab5c8;

  font-size:14px;

  line-height:1.75;
}

.completion-count{
  position:relative;

  margin-top:19px;

  color:var(--cyan);

  font-family:"Outfit",sans-serif;

  font-size:15px;

  font-weight:700;
}

.completion-actions{
  position:relative;

  display:flex;

  justify-content:center;

  gap:10px;

  flex-wrap:wrap;

  margin-top:24px;
}

/* =========================================================
   CONFETTI
========================================================= */

.confetti{
  position:fixed;

  z-index:1100;

  width:8px;
  height:14px;

  left:50%;
  top:50%;

  pointer-events:none;

  background:var(--color);

  animation:
    confettiFly var(--duration) cubic-bezier(.15,.8,.25,1) var(--delay) forwards;
}

@keyframes confettiFly{

  0%{
    transform:
      translate(-50%,-50%)
      rotate(0deg)
      scale(.5);

    opacity:0;
  }

  12%{
    opacity:1;
  }

  100%{
    transform:
      translate(
        var(--x),
        var(--y)
      )
      rotate(var(--rotate))
      scale(1);

    opacity:0;
  }
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:850px){

  :root{
    --piece-width:110px;
    --piece-height:94px;

    --board-width:660px;
    --board-height:282px;
  }

  .game-shell{
    padding:17px;
  }

  .instructions{
    grid-template-columns:1fr;
  }

  .tray{
    min-height:300px;
  }

}

@media(max-width:600px){

  :root{
    --piece-width:88px;
    --piece-height:76px;

    --board-width:528px;
    --board-height:228px;
  }

  .page{
    width:95vw;
  }

  .topbar{
    margin-bottom:20px;
  }

  .hero{
    padding-bottom:20px;
  }

  .hero h1{
    font-size:45px;
  }

  .hero-description{
    font-size:13px;
  }

  .hud-card{
    min-width:120px;
  }

  .hud-value{
    font-size:17px;
  }

  .game-shell{
    border-radius:24px;
  }

  .board-wrap{
    padding-left:0;
    padding-right:0;
  }

  .tray{
    min-height:340px;
  }

  .completion-card{
    padding:
      35px
      20px
      28px;
  }

}

@media(prefers-reduced-motion:reduce){

  *,
  *:before,
  *:after{
    animation-duration:.01ms!important;
    animation-iteration-count:1!important;
    scroll-behavior:auto!important;
  }

}
</style>
</head>

<body>

<div id="ambient"></div>

<div class="page">

  <header class="topbar">

    <div class="gift-label">
      <span class="gift-dot"></span>
      Gift 17 · The Missing Pieces
    </div>

    <button
      class="back-button"
      onclick="goBack()"
    >
      ← Gifts
    </button>

  </header>


  <section class="hero">

    <div class="hero-symbol">
      🧩
    </div>

    <h1>
      The Missing Pieces
    </h1>

    <p class="hero-description">
      There are 18 pieces scattered everywhere.
      Put them back where they belong.
      No shortcuts. No picture on the box.
      Just you, the pieces, and a little patience.
    </p>

    <div class="hero-note">
      6 × 3 · 18 pieces · one finished picture
    </div>

  </section>


  <section class="hud">

    <div class="hud-card">

      <span class="hud-label">
        Pieces placed
      </span>

      <span
        class="hud-value"
        id="progressValue"
      >
        0 / 18
      </span>

    </div>


    <div class="hud-card">

      <span class="hud-label">
        Remaining
      </span>

      <span
        class="hud-value"
        id="remainingValue"
      >
        18
      </span>

