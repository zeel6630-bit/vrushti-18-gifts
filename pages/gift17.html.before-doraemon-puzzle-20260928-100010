}


/* ==========================================================
   RANDOM ROTATION
========================================================== */

function randomRotation(){

  const values = [
    -18,
    -12,
    -8,
    0,
    8,
    12,
    18
  ];

  return values[
    Math.floor(
      Math.random()*values.length
    )
  ];
}


/* ==========================================================
   SCATTER
========================================================== */

function scatterPieces(){

  tray.innerHTML = "";

  pieces = [];

  placedCount = 0;

  selectedPiece = null;

  for(
    let i=0;
    i<TOTAL;
    i++
  ){

    const piece =
      createPiece(i);

    pieces.push(piece);

    tray.appendChild(piece);

    positionPieceRandomly(
      piece,
      true
    );
  }

  updateHUD();

  updateRotationButtons();
}


function positionPieceRandomly(
  piece,
  initial=false
){

  const trayRect =
    tray.getBoundingClientRect();

  const width =
    tray.clientWidth;

  const height =
    tray.clientHeight;

  const pieceWidth =
    parseFloat(
      getComputedStyle(
        document.documentElement
      ).getPropertyValue(
        "--piece-width"
      )
    );

  const pieceHeight =
    parseFloat(
      getComputedStyle(
        document.documentElement
      ).getPropertyValue(
        "--piece-height"
      )
    );

  const padding = 8;

  const maxX =
    Math.max(
      padding,
      width - pieceWidth - padding
    );

  const maxY =
    Math.max(
      padding,
      height - pieceHeight - padding
    );

  const x =
    padding +
    Math.random() *
    Math.max(
      1,
      maxX - padding
    );

  const y =
    padding +
    Math.random() *
    Math.max(
      1,
      maxY - padding
    );

  piece.style.setProperty(
    "--px",
    `${x}px`
  );

  piece.style.setProperty(
    "--py",
    `${y}px`
  );

  piece.style.setProperty(
    "--rotation",
    `${randomRotation()}deg`
  );

  piece.style.setProperty(
    "--scale",
    "1"
  );

}


/* ==========================================================
   POINTER DRAG
========================================================== */

function startDrag(event){

  const piece =
    event.currentTarget;

  if(
    piece.dataset.locked === "true"
  ){
    return;
  }

  event.preventDefault();

  selectedPiece =
    piece;

  updateRotationButtons();

  const rect =
    piece.getBoundingClientRect();

  const trayRect =
    tray.getBoundingClientRect();

  const pointerX =
    event.clientX;

  const pointerY =
    event.clientY;

  dragState = {

    piece,

    offsetX:
      pointerX - rect.left,

    offsetY:
      pointerY - rect.top,

    trayRect

  };

  piece.classList.add(
    "dragging"
  );

  piece.setPointerCapture(
    event.pointerId
  );

  piece.addEventListener(
    "pointermove",
    moveDrag
  );

  piece.addEventListener(
    "pointerup",
    endDrag
  );

  piece.addEventListener(
    "pointercancel",
    endDrag
  );

}


function moveDrag(event){

  if(!dragState){
    return;
  }

  const {
    piece,
    offsetX,
    offsetY,
    trayRect
  } = dragState;

  const pieceWidth =
    piece.offsetWidth;

  const pieceHeight =
    piece.offsetHeight;

  let x =
    event.clientX -
    trayRect.left -
    offsetX;

  let y =
    event.clientY -
    trayRect.top -
    offsetY;

  x =
    Math.max(
      -20,
      Math.min(
        tray.clientWidth -
        pieceWidth +
        20,
        x
      )
    );

  y =
    Math.max(
      -20,
      Math.min(
        tray.clientHeight -
        pieceHeight +
        20,
        y
      )
    );

  piece.style.setProperty(
    "--px",
    `${x}px`
  );

  piece.style.setProperty(
    "--py",
    `${y}px`
  );

}


function endDrag(event){

  if(!dragState){
    return;
  }

  const piece =
    dragState.piece;

  piece.classList.remove(
    "dragging"
  );

  try{
    piece.releasePointerCapture(
      event.pointerId
    );
  }catch(e){}

  piece.removeEventListener(
    "pointermove",
    moveDrag
  );

  piece.removeEventListener(
    "pointerup",
    endDrag
  );

  piece.removeEventListener(
    "pointercancel",
    endDrag
  );

  dragState = null;

  checkPlacement(
    piece
  );
}


/* ==========================================================
   CHECK PLACEMENT
========================================================== */

function checkPlacement(piece){

  if(
    piece.dataset.locked === "true"
  ){
    return;
  }

  const index =
    Number(piece.dataset.index);

  const col =
    index % COLS;

  const row =
    Math.floor(index / COLS);

  const targetX =
    col * 140;

  const targetY =
    row * 120;

  const currentX =
    parseFloat(
      piece.style.getPropertyValue(
        "--px"
      )
    ) || 0;

  const currentY =
    parseFloat(
      piece.style.getPropertyValue(
        "--py"
      )
    ) || 0;

  /*
    Because pieces live inside the tray and the board
    is physically above it, the player is judged by
    proximity after dragging the piece near the board.
  */

  const boardRect =
    board.getBoundingClientRect();

  const trayRect =
    tray.getBoundingClientRect();

  const pieceRect =
    piece.getBoundingClientRect();

  const pieceCenterX =
    pieceRect.left +
    pieceRect.width/2;

  const pieceCenterY =
    pieceRect.top +
    pieceRect.height/2;

  const targetCenterX =
    boardRect.left +
    targetX +
    pieceRect.width/2;

  const targetCenterY =
    boardRect.top +
    targetY +
    pieceRect.height/2;

  const dx =
    pieceCenterX -
    targetCenterX;

  const dy =
    pieceCenterY -
    targetCenterY;

  const distance =
    Math.sqrt(
      dx*dx +
      dy*dy
    );

  const rotation =
    getRotation(piece);

  const normalizedRotation =
    Math.abs(
      normalizeRotation(rotation)
    );

  /*
    We allow a generous physical snap range.
    The player still needs to move the correct piece
    near its correct slot and have approximately the
    right rotation.
  */

  const SNAP_DISTANCE =
    Math.max(
      48,
      pieceRect.width * .55
    );

  const ROTATION_TOLERANCE =
    22;

  if(
    distance <= SNAP_DISTANCE &&
    normalizedRotation <= ROTATION_TOLERANCE
  ){

    lockPiece(
      piece,
      col,
      row
    );

  }else{

    piece.classList.add(
      "shake"
    );

    setTimeout(()=>{
      piece.classList.remove(
        "shake"
      );
    },430);

  }

}


/* ==========================================================
   ROTATION
========================================================== */

function getRotation(piece){

  const value =
    getComputedStyle(
      piece
    ).getPropertyValue(
      "--rotation"
    );

  return parseFloat(value) || 0;
}


function normalizeRotation(value){

  let rotation =
    value % 360;

  if(rotation > 180){
    rotation -= 360;
  }

  if(rotation < -180){
    rotation += 360;
  }

  return rotation;
}


function rotateSelected(amount){

  if(!selectedPiece){
    return;
  }

  if(
    selectedPiece.dataset.locked === "true"
  ){
    return;
  }

  const currentRotation =
    getRotation(
      selectedPiece
    );

  selectedPiece.style.setProperty(
    "--rotation",
    `${currentRotation + amount}deg`
  );

  updateRotationButtons();
}


rotateLeft.addEventListener(
  "click",
  ()=>{
    rotateSelected(-90);
  }
);

rotateRight.addEventListener(
  "click",
  ()=>{
    rotateSelected(90);
  }
);


function updateRotationButtons(){

  const disabled =
    !selectedPiece ||
    selectedPiece.dataset.locked === "true";

  rotateLeft.disabled =
    disabled;

  rotateRight.disabled =
    disabled;
}


/* ==========================================================
   LOCK CORRECT PIECE
========================================================== */

function lockPiece(
  piece,
  col,
  row
){

  if(
    piece.dataset.locked === "true"
  ){
    return;
  }

  piece.dataset.locked =
    "true";

  placedCount++;

  /*
    Move the piece into the board visually.
    The actual piece is relocated from tray to board,
    then its coordinates become fixed.
  */

  board.appendChild(
    piece
  );

  piece.classList.add(
    "locked"
  );

  piece.style.setProperty(
    "--px",
    `${col * 140}px`
  );

  piece.style.setProperty(
    "--py",
    `${row * 120}px`
  );

  piece.style.setProperty(
    "--rotation",
    "0deg"
  );

  piece.style.setProperty(
    "--scale",
    "1"
  );

  /*
    Lock movement permanently.
  */

  piece.style.pointerEvents =
    "none";

  selectedPiece = null;

  updateHUD();

  updateRotationButtons();

  createLockSpark(
    piece
  );

  if(
    placedCount === TOTAL
  ){

    setTimeout(
      completePuzzle,
      650
    );

  }else{

    boardStatus.textContent =
      placedCount +
      " pieces are home. Keep going. ✨";

  }

}


/* ==========================================================
   HUD
========================================================== */

function updateHUD(){

  progressValue.textContent =
    `${placedCount} / ${TOTAL}`;

  remainingValue.textContent =
    `${TOTAL - placedCount}`;

  if(
    placedCount === 0
  ){

    boardStatus.textContent =
      "Find where everything belongs.";

  }else if(
    placedCount < TOTAL
  ){

    boardStatus.textContent =
      `${placedCount} piece${placedCount===1?"":"s"} locked in.`;

  }else{

    boardStatus.textContent =
      "Everything is complete. ✨";

  }

}


/* ==========================================================
   LOCK SPARK
========================================================== */

function createLockSpark(piece){

  const rect =
    piece.getBoundingClientRect();

  const x =
    rect.left +
    rect.width/2;

  const y =
    rect.top +
    rect.height/2;

  for(
    let i=0;
    i<10;
    i++
  ){

    const spark =
      document.createElement(
        "div"
      );

    spark.className =
      "heart-burst-temp";

    spark.style.position =
      "fixed";

    spark.style.left =
      `${x}px`;

    spark.style.top =
      `${y}px`;

    spark.style.width =
      "5px";

    spark.style.height =
      "5px";

    spark.style.borderRadius =
      "50%";

    spark.style.background =
      i%2
        ? "#79f0e1"
        : "#8bd8ff";

    spark.style.boxShadow =
      "0 0 12px currentColor";

    spark.style.pointerEvents =
      "none";

    spark.style.zIndex =
      "900";

    spark.animate(
      [
        {
          transform:"translate(-50%,-50%) scale(1)",
          opacity:1
        },
        {
          transform:
            `translate(
              calc(-50% + ${(Math.random()-.5)*100}px),
              calc(-50% + ${(Math.random()-.5)*100}px)
            )
            scale(0)`,
          opacity:0
        }
      ],
      {
        duration:500 + Math.random()*300,
        easing:"cubic-bezier(.2,.8,.2,1)"
      }
    );

    document.body.appendChild(
      spark
    );

    setTimeout(
      ()=>{
        spark.remove();
      },
      900
    );

  }

}


/* ==========================================================
   COMPLETION
========================================================== */

function completePuzzle(){

  completion.classList.add(
    "show"
  );

  createConfetti();

  boardStatus.textContent =
    "Puzzle complete. ✨";

}


function createConfetti(){

  const colors = [
    "#79f0e1",
    "#8bd8ff",
    "#b6a2ff",
    "#ff9fc9",
    "#ffe19a",
    "#ffffff"
  ];

  for(
    let i=0;
    i<90;
    i++
  ){

    const piece =
      document.createElement(
        "div"
      );

    piece.className =
      "confetti";

    piece.style.setProperty(
      "--color",
      colors[
        Math.floor(
          Math.random()*
          colors.length
        )
      ]
    );

    piece.style.setProperty(
      "--x",
      `${(Math.random()-.5)*110}vw`
    );

    piece.style.setProperty(
      "--y",
      `${(Math.random()-.5)*100}vh`
    );

    piece.style.setProperty(
      "--rotate",
      `${(Math.random()-.5)*1200}deg`
    );

    piece.style.setProperty(
      "--duration",
      `${1.2 + Math.random()*1.5}s`
    );

    piece.style.setProperty(
      "--delay",
      `${Math.random()*.25}s`
    );

    piece.style.left =
      "50%";

    piece.style.top =
      "50%";

    document.body.appendChild(
      piece
    );

    setTimeout(
      ()=>{
        piece.remove();
      },
      3200
    );

  }

}


/* ==========================================================
   RESTART
========================================================== */

function restartPuzzle(){

  completion.classList.remove(
    "show"
  );

  scatterPieces();

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });

}


/* ==========================================================
   RESET BUTTON
========================================================== */

resetButton.addEventListener(
  "click",
  ()=>{

    if(
      confirm(
        "Scatter all 18 pieces again?"
      )
    ){

      restartPuzzle();

    }

  }
);


/* ==========================================================
   BACK TO GIFTS
========================================================== */

function goBack(){

  /*
    Keep this path compatible with the
    existing birthday-site structure.
  */

  window.location.href =
    "../index.html";

}


/* ==========================================================
   KEYBOARD
========================================================== */

document.addEventListener(
  "keydown",
  event=>{

    if(
      event.key === "Escape"
    ){

      completion.classList.remove(
        "show"
      );

      return;

    }

    if(
      event.key === "r" ||
      event.key === "R"
    ){

      rotateRight.click();

    }

    if(
      event.key === "e" ||
      event.key === "E"
    ){

      rotateLeft.click();

    }

  }
);


/* ==========================================================
   AMBIENT PARTICLES
========================================================== */

function createAmbient(){

  const ambient =
    document.getElementById(
      "ambient"
    );

  const colors = [
    "#79f0e1",
    "#8bd8ff",
    "#b6a2ff",
    "#ff9fc9",
    "#ffe19a"
  ];


  for(
    let i=0;
    i<12;
    i++
  ){

    const orb =
      document.createElement(
        "div"
      );

    orb.className =
      "ambient-orb";

    orb.style.setProperty(
      "--size",
      `${80 + Math.random()*220}px`
    );

    orb.style.setProperty(
      "--x",
      `${Math.random()*100}%`
    );

    orb.style.setProperty(
      "--y",
      `${Math.random()*100}%`
    );

    orb.style.setProperty(
      "--mx",
      `${(Math.random()-.5)*100}px`
    );

    orb.style.setProperty(
      "--my",
      `${(Math.random()-.5)*120}px`
    );

    orb.style.setProperty(
      "--duration",
      `${6 + Math.random()*9}s`
    );

    orb.style.setProperty(
      "--delay",
      `${-Math.random()*8}s`
    );

    ambient.appendChild(
      orb
    );

  }


  for(
    let i=0;
    i<55;
    i++
  ){

    const dust =
      document.createElement(
        "div"
      );

    dust.className =
      "dust";

    dust.style.setProperty(
      "--size",
      `${1 + Math.random()*3}px`
    );

    dust.style.setProperty(
      "--x",
      `${Math.random()*100}%`
    );

    dust.style.setProperty(
      "--duration",
      `${9 + Math.random()*16}s`
    );

    dust.style.setProperty(
      "--delay",
      `${-Math.random()*20}s`
    );

    dust.style.setProperty(
      "--drift",
      `${(Math.random()-.5)*180}px`
    );

    dust.style.setProperty(
      "--opacity",
      `${.18 + Math.random()*.48}`
    );

    dust.style.setProperty(
      "--color",
      colors[
        Math.floor(
          Math.random()*
          colors.length
        )
      ]
    );

    ambient.appendChild(
      dust
    );

  }

}


/* ==========================================================
   INITIALIZE
========================================================== */

createAmbient();

createSlots();

scatterPieces();

</script>

