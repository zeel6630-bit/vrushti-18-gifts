      94% 50%,
      96% 56%,
      ${r}% 60%,

      ${r}% 100%,
      58% 100%,
      54% 95%,
      50% 92%,
      46% 95%,
      42% 100%,

      ${l}% 100%,

      ${l}% 60%,
      4% 56%,
      6% 50%,
      4% 44%,
      ${l}% 40%,

      ${l}% 0%
    )
  `;
}


/* ==========================================================
   CREATE BOARD SLOTS
========================================================== */

function createSlots(){

  board.innerHTML = "";

  for(
    let i=0;
    i<TOTAL;
    i++
  ){

    const col =
      i % COLS;

