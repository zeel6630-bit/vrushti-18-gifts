const ART =
  createArtwork();


/* ==========================================================
   PUZZLE CLIP PATHS
========================================================== */

function makeClipPath(index){

  const col =
    index % COLS;

  const row =
    Math.floor(index / COLS);

  const x = col;
  const y = row;

  const tab =
    7;

  const side =
    25;

  /*
    Each piece is intentionally slightly
    irregular to create a physical puzzle feel.
  */

  const left =
    col === 0
      ? "0% 0%"
      : "0% 0%";

  /*
    We use a polygon silhouette.
    It is deliberately simple enough to remain
    performant on mobile.
  */

  const l =
    col === 0
      ? 0
      : 7;

  const r =
    col === COLS-1
      ? 100
      : 93;

  const t =
    row === 0
      ? 0
      : 7;

  const b =
    row === ROWS-1
      ? 100
      : 93;

  return `
    polygon(
      ${l}% 0%,
      42% 0%,
      46% 5%,
      50% 8%,
      54% 5%,
      58% 0%,
      ${r}% 0%,

      ${r}% 40%,
